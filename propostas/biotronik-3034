            renderPrices();
        }

        function renderPrices() {
            const container = document.getElementById('price-display-box');
            const btnLink = document.getElementById('btn-aprova-link');
            if (!container) return;

            let baseVal = pricingMatrix[selectedLine][selectedRetention];
            if (includeNobreaks) {
                baseVal += pricingMatrix.nobreakAddon;
            }

            const lineName = selectedLine === 'intelbras' ? 'Linha Intelbras Corporativa' : 'Linha Vision Custom';
            const retentionTxt = selectedRetention + ' Dias de Gravação';
            const nobTxt = includeNobreaks ? ' (Com 3 Nobreaks 1200VA)' : ' (Sem Nobreaks)';

            if (paymentMode === 'avista') {
                const signal = baseVal / 2;
                container.innerHTML = `
                    <div class="flex flex-col items-center w-full animate-fade-in font-sans">
                        <p class="text-[9px] md:text-[10px] text-[#8a6208] uppercase tracking-widest font-bold mb-0.5">
                            À Vista no PIX (50% Sinal / 50% Conclusão) • ${lineName}
                        </p>
                        <span class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-3">R$ ${formatCurrency(baseVal)}</span>
                        <span class="text-xs text-zinc-500 mb-3">${retentionTxt}${nobTxt}</span>

                        <div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div class="bg-white border border-gray-200 rounded-xl py-2 px-3 flex flex-col items-center justify-center relative overflow-hidden shadow-xs">
                                <div class="absolute top-0 left-0 w-1 h-full bg-[#34d399] rounded-l-lg"></div>
                                <span class="text-[8px] font-bold uppercase tracking-widest text-brand-goldDark mb-0.5">Sinal para Compra dos Equipamentos (50%)</span>
                                <span class="text-sm font-bold text-gray-900">R$ ${formatCurrency(signal)}</span>
                            </div>
                            <div class="bg-white border border-gray-200 rounded-xl py-2 px-3 flex flex-col items-center justify-center relative overflow-hidden shadow-xs">
                                <div class="absolute top-0 left-0 w-1 h-full bg-[#c8a048] rounded-l-lg"></div>
                                <span class="text-[8px] font-bold uppercase tracking-widest text-brand-goldDark mb-0.5">Saldo na Conclusão e Homologação (50%)</span>
                                <span class="text-sm font-bold text-gray-900">R$ ${formatCurrency(signal)}</span>
                            </div>
                        </div>
                    </div>
                `;

                if (btnLink) {
                    const msg = `Olá Gabriel, analisamos a proposta de CFTV IP da Biotronik Comercial (3 Pavimentos) no formato ${lineName} com ${retentionTxt}${nobTxt} e gostaríamos de aprovar no valor de R$ ${formatCurrency(baseVal)} à vista via PIX (50/50).`;
                    btnLink.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(msg);
                }

            } else {
                const installmentVal = (baseVal * 1.1999) / 12;
                const totalParcelado = baseVal * 1.1999;

                container.innerHTML = `
                    <div class="flex flex-col items-center w-full animate-fade-in font-sans">
                        <div class="flex items-baseline justify-center gap-1.5 mb-1">
                            <span class="text-xl md:text-2xl font-bold text-brand-yellow">12x de R$</span> 
                            <span class="text-4xl md:text-5xl font-black text-gray-900">${formatCurrency(installmentVal)}</span>
                        </div>
                        <div class="inline-flex items-center gap-1.5 bg-blue-50 border border-blue-200 text-blue-700 px-3 py-0.5 rounded-full w-fit shadow-xs mb-2">
                            <i data-lucide="credit-card" class="w-3.5 h-3.5"></i>
                            <span class="text-[10px] font-bold uppercase tracking-wider">Cartão Corporativo sem Desembolso à Vista</span>
                        </div>
                        <p class="text-[11px] text-gray-500 font-medium">Total Parcelado: R$ ${formatCurrency(totalParcelado)} • ${retentionTxt}${nobTxt}</p>
                    </div>
                `;

                if (btnLink) {
                    const msg = `Olá Gabriel, analisamos a proposta de CFTV IP da Biotronik Comercial (3 Pavimentos) no formato ${lineName} com ${retentionTxt}${nobTxt} e gostaríamos de aprovar no parcelamento de 12x de R$ ${formatCurrency(installmentVal)} no cartão.`;
                    btnLink.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(msg);
                }
            }

            initIcons();
        }

        document.addEventListener("DOMContentLoaded", () => {
            setHardwareLine('intelbras');
            setRetentionDays(30);
        });

        // Observer de Animações
        try {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('active');
                });
            }, { threshold: 0.05 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        } catch(e) {
            document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
        }

        // Scroll Control
        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            const ctaFloat = document.getElementById('cta-float');
            
            if (window.scrollY > 40) {
                if(navbar) navbar.classList.add('shadow-md');
            } else {
                if(navbar) navbar.classList.remove('shadow-md');
            }

            if (window.scrollY > 400) {
                if (ctaFloat) {
                    ctaFloat.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
                    ctaFloat.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
                }
            } else {
                if (ctaFloat) {
                    ctaFloat.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
                    ctaFloat.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
                }
            }
        });
    </script>
    </body>
    </html>
