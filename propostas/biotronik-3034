                        window.clarity("event", "Proposta_Desbloqueada");
                    } catch(e) {}
                }

                // Notificação silenciosa
                fetch('https://api.staticforms.dev/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        accessKey: "sf_077ej49gjha153gk3m6ceecf",
                        subject: "🚨 ALERTA: Proposta Acessada (Biotronik Comercial - 3 Pavimentos)",
                        name: "Sistema Vision",
                        email: "diretoria@visionsp.com.br",
                        message: "A proposta de CFTV IP da Biotronik Comercial foi aberta!\n\n🔑 Senha: " + input + "\n🏢 Cliente: Biotronik Comercial\n🕒 Data: " + new Date().toLocaleString('pt-BR')
                    })
                }).catch(() => {});

                setTimeout(() => {
                    if (lockScreen) lockScreen.style.display = 'none';
