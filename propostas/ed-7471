    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        const ctaFloat = document.getElementById('cta-float');
        
        if (window.scrollY > 50) {
            if(navbar) navbar.classList.add('shadow-md');
        } else {
            if(navbar) navbar.classList.remove('shadow-md');
        }

        if (window.scrollY > 400) {
            if(ctaFloat) {
                ctaFloat.classList.remove('hidden', 'opacity-0', 'translate-y-10', 'pointer-events-none');
                ctaFloat.classList.add('opacity-100', 'translate-y-0');
            }
        } else {
            if(ctaFloat) {
                ctaFloat.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }
        }
    });

    document.addEventListener("DOMContentLoaded", function() {
        const video = document.getElementById("vision-video");
        const overlay = document.getElementById("unmute-overlay");
        if (video && overlay) {
            overlay.addEventListener("click", function(e) {
                e.stopPropagation(); 
                video.muted = false;
                video.loop = true; 
                video.currentTime = 0;
                video.play().catch(err => {});
                overlay.style.opacity = "0";
                setTimeout(() => { overlay.style.display = "none"; }, 500); 

                if (window.clarity) {
                    try { window.clarity("event", "Video_Assistido_VisionVideo_EdWilson"); } catch(err){}
                }
            });
            video.addEventListener("click", function() {
                if (overlay.style.display === "none") {
                    if (video.paused) { video.play(); } else { video.pause(); }
                }
            });
        }

        const demoVideo = document.getElementById("demo-facial-video");
        if (demoVideo) {
            demoVideo.addEventListener("click", function() {
                if (demoVideo.paused) { demoVideo.play(); } else { demoVideo.pause(); }
            });
        }
    });

    function toggleDemoSound() {
        const demoVideo = document.getElementById("demo-facial-video");
        const icon = document.getElementById("demo-sound-icon");
        const text = document.getElementById("demo-sound-text");
        if (!demoVideo) return;

        demoVideo.muted = !demoVideo.muted;
        if (!demoVideo.muted) {
            demoVideo.play().catch(() => {});
            if (text) text.textContent = "Som Ativo";
            if (icon) icon.setAttribute("data-lucide", "volume-2");
            if (window.clarity) {
                try { window.clarity("event", "Video_Demo_Facial_Com_Audio_EdWilson"); } catch(err){}
            }
        } else {
            if (text) text.textContent = "Ativar Áudio";
            if (icon) icon.setAttribute("data-lucide", "volume-x");
        }
        initIcons();
    }
</script>
</body>
</html>
