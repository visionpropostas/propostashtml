    let currentScope = 'full';     // 'full' ou 'cftv'
    let currentPayment = 'pix';    // 'pix' ou 'card'

    function formatBRL(val) {
        return val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function selectScope(scope) {
        currentScope = scope;
        const btnFull = document.getElementById('btn-scope-full');
        const btnCftv = document.getElementById('btn-scope-cftv');

        if (scope === 'full') {
            btnFull.className = "flex-1 py-2.5 px-3 rounded-xl text-xs font-bold bg-white text-gray-900 shadow-sm transition-all flex items-center justify-center gap-1.5";
            btnCftv.className = "flex-1 py-2.5 px-3 rounded-xl text-xs font-bold bg-transparent text-gray-600 hover:text-gray-900 transition-all flex items-center justify-center gap-1.5";
        } else {
            btnCftv.className = "flex-1 py-2.5 px-3 rounded-xl text-xs font-bold bg-white text-gray-900 shadow-sm transition-all flex items-center justify-center gap-1.5";
            btnFull.className = "flex-1 py-2.5 px-3 rounded-xl text-xs font-bold bg-transparent text-gray-600 hover:text-gray-900 transition-all flex items-center justify-center gap-1.5";
        }

        updateScopeContent();
        renderPriceDisplay();
        if (window.clarity) window.clarity("event", "Mudou_Escopo_Juliana_" + scope);
    }

    function selectPayment(paymentMode) {
        currentPayment = paymentMode;
        const btnPix = document.getElementById('btn-pay-pix');
        const btnCard = document.getElementById('btn-pay-card');
        const labelMode = document.getElementById('label-pricing-mode');

        if (paymentMode === 'pix') {
            btnPix.className = "px-5 py-2 rounded-full text-xs font-bold bg-brand-yellow text-black shadow transition-all";
            btnCard.className = "px-5 py-2 rounded-full text-xs font-bold bg-transparent text-gray-500 hover:text-gray-800 transition-all";
            if (labelMode) labelMode.textContent = "Investimento à Vista (PIX c/ Desconto)";
        } else {
            btnCard.className = "px-5 py-2 rounded-full text-xs font-bold bg-brand-yellow text-black shadow transition-all";
            btnPix.className = "px-5 py-2 rounded-full text-xs font-bold bg-transparent text-gray-500 hover:text-gray-800 transition-all";
            if (labelMode) labelMode.textContent = "Investimento Parcelado no Cartão";
        }

        renderPriceDisplay();
        if (window.clarity) window.clarity("event", "Mudou_Pagamento_Juliana_" + paymentMode);
    }

    function updateScopeContent() {
        const data = pricingData[currentScope];
        const badgeEl = document.getElementById('scope-badge');
        const titleEl = document.getElementById('scope-title');
        const listEl = document.getElementById('scope-list');

        if (badgeEl) badgeEl.textContent = data.badge;
        if (titleEl) titleEl.textContent = data.title;

        if (listEl) {
            listEl.innerHTML = data.items.map(item => `
                <li class="flex items-start gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-brand-yellow shrink-0 mt-0.5"></i>
                    <span>${item}</span>
                </li>
            `).join('');
        }
    }

    function renderPriceDisplay() {
        const box = document.getElementById('price-display-box');
        const ctaBtn = document.getElementById('btn-whatsapp-cta');
        const ctaText = document.getElementById('cta-btn-text');
        const data = pricingData[currentScope];

        if (!box) return;

        let html = '';
        let whatsappMsg = '';

        if (currentPayment === 'pix') {
            html = `
                <div class="flex flex-col items-center justify-center w-full animate-fade-in">
                    <div class="flex items-baseline justify-center gap-1 mb-1">
                        <span class="text-xl font-bold text-gray-400">R$</span>
                        <span class="text-4xl sm:text-5xl font-extrabold text-[#111827] tracking-tight">${formatBRL(data.pix).split(',')[0]}<span class="text-2xl text-gray-400">,${formatBRL(data.pix).split(',')[1]}</span></span>
                    </div>
                    <div class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider mt-1">
                        <i data-lucide="zap" class="w-3 h-3"></i> À vista no PIX com Desconto
                    </div>
                    
                    <div class="w-full mt-4 space-y-1.5 text-left">
                        <div class="bg-white border border-gray-200 rounded-lg p-2.5 shadow-sm text-xs flex justify-between items-center">
                            <span class="text-gray-500 font-medium">Sinal (Pedido de Equipamentos):</span>
                            <strong class="text-gray-900">R$ ${formatBRL(data.pixHalf)}</strong>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-lg p-2.5 shadow-sm text-xs flex justify-between items-center">
                            <span class="text-gray-500 font-medium">Entrega (Finalização &amp; App):</span>
                            <strong class="text-gray-900">R$ ${formatBRL(data.pixHalf)}</strong>
                        </div>
                    </div>
                </div>
            `;
            whatsappMsg = `${data.whatsappText} no valor de *R$ ${formatBRL(data.pix)} no PIX*. Vamos alinhar a liberação da equipe!`;
            if (ctaText) ctaText.textContent = `Aprovar no PIX (R$ ${formatBRL(data.pix)})`;

        } else {
            html = `
                <div class="flex flex-col items-center justify-center w-full animate-fade-in">
                    <span class="text-[11px] font-bold text-gray-400 mb-0.5">Parcelamento em até 12x</span>
                    <div class="flex items-baseline justify-center gap-1 mb-1">
                        <span class="text-xl font-bold text-[#111827]">12x de R$</span>
                        <span class="text-4xl sm:text-5xl font-extrabold text-[#111827] tracking-tight">${formatBRL(data.cardMonthly).split(',')[0]}<span class="text-2xl text-gray-400">,${formatBRL(data.cardMonthly).split(',')[1]}</span></span>
                    </div>
                    <div class="inline-flex items-center gap-1 bg-blue-50 text-blue-700 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider mt-1">
                        <i data-lucide="credit-card" class="w-3 h-3"></i> Cartão de Crédito
                    </div>
                    <p class="text-[11px] text-gray-500 font-medium mt-3">Total parcelado: R$ ${formatBRL(data.cardTotal)}</p>
                </div>
            `;
            whatsappMsg = `${data.whatsappText} parcelado em *12x de R$ ${formatBRL(data.cardMonthly)} no cartão*. Vamos alinhar a liberação da equipe!`;
            if (ctaText) ctaText.textContent = `Aprovar em 12x no Cartão`;
        }

        box.innerHTML = html;
        if (ctaBtn) ctaBtn.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(whatsappMsg);
        
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }

    // ACCORDION
    function toggleAccordion(button) {
        const item = button.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }

    // CONTROLE DE ACESSO
    function checkPassword() {
        const inputEl = document.getElementById('password-input');
        if (!inputEl) return;

        const input = inputEl.value.trim().toUpperCase();
        const errorMsg = document.getElementById('error-msg');
        const btnUnlock = document.getElementById('btn-unlock');
        const unlockIcon = document.getElementById('unlock-icon');
        const unlockText = document.getElementById('unlock-text');
        const unlockArrow = document.getElementById('unlock-arrow');

        const validPasswords = ['JULIANA2026', 'JULIANA', 'PAULISTA', 'VISION'];

        if (validPasswords.includes(input)) {
            if (btnUnlock) btnUnlock.disabled = true;
            if (unlockText) unlockText.textContent = "Liberando Proposta...";
            if (unlockIcon) unlockIcon.setAttribute('class', "w-5 h-5 animate-spin text-black");
            if (unlockArrow) unlockArrow.style.display = 'none';

            setTimeout(() => {
                const lockScreen = document.getElementById('lock-screen');
                if (lockScreen) lockScreen.style.opacity = '0';

                const video = document.getElementById("vision-video");
                if (video && video.paused) {
                    video.muted = true;
                    video.play().catch(() => {});
                }

                if (window.clarity) {
                    try {
                        window.clarity("consent");
                        window.clarity("identify", "juliana-paulista", undefined, undefined, "Juliana (Paulista 18 Andar)");
                        window.clarity("set", "Proposta", "CFTV_Facial_Juliana");
                        window.clarity("event", "Proposta_Desbloqueada");
                    } catch(e) {}
                }

                // Notificação silenciosa de abertura
                fetch('https://api.staticforms.dev/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        accessKey: "sf_077ej49gjha153gk3m6ceecf",
                        subject: "🚨 ALERTA: Proposta Acessada (Juliana - Paulista 18º Andar)",
                        name: "Sistema Vision",
                        email: "diretoria@visionsp.com.br",
                        message: "A cliente Juliana acessou a proposta corporativa na Av. Paulista!\n\n🔑 Senha Utilizada: " + input + "\n🕒 Horário: " + new Date().toLocaleString('pt-BR')
                    })
                }).catch(() => {});

                setTimeout(() => {
                    if (lockScreen) lockScreen.style.display = 'none';
                    const htmlRoot = document.getElementById('html-root');
                    if (htmlRoot) {
                        htmlRoot.classList.remove('overflow-hidden', 'h-screen');
                        htmlRoot.classList.add('overflow-x-hidden');
                    }
                    document.body.classList.remove('overflow-hidden', 'h-screen');
                    document.body.classList.add('overflow-x-hidden');
                }, 700);

            }, 500);

        } else {
            if (errorMsg) errorMsg.classList.remove('hidden');
            inputEl.style.borderColor = 'rgba(239,68,68,0.5)';
            setTimeout(() => {
                if (errorMsg) errorMsg.classList.add('hidden');
                inputEl.style.borderColor = '';
            }, 3000);
        }
    }

    // INICIALIZAÇÃO
    document.addEventListener("DOMContentLoaded", function() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }

        const pwdInput = document.getElementById('password-input');
        if (pwdInput) {
            pwdInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });
        }

        // Scroll Reveal
        try {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('active');
                });
            }, { threshold: 0.08 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        } catch(e) {
            document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
        }

        // Vídeo e Áudio
        const videoHero = document.getElementById("vision-video");
        const overlayHero = document.getElementById("unmute-overlay");

        if (videoHero && overlayHero) {
            overlayHero.addEventListener("click", function(e) {
                e.stopPropagation();
                videoHero.muted = false;
                videoHero.loop = true;
                videoHero.currentTime = 0;
                videoHero.play().catch(() => {});
                overlayHero.style.opacity = "0";
                setTimeout(() => { overlayHero.style.display = "none"; }, 400);

                if (window.clarity) {
                    try { window.clarity("event", "Video_Assistido_Juliana"); } catch(err) {}
                }
            });

            videoHero.addEventListener("click", function() {
                if (overlayHero.style.display === "none") {
                    if (videoHero.paused) { videoHero.play(); } else { videoHero.pause(); }
                }
            });
        }

        // Inicializa escopo e preços
        updateScopeContent();
        renderPriceDisplay();

        // Pausa no Marquee com Touch
        const reviewsTrack = document.getElementById('reviews-track');
        const reviewsContainer = document.getElementById('reviews-container');
        if (reviewsTrack && reviewsContainer) {
            reviewsContainer.addEventListener('touchstart', function() {
                reviewsTrack.classList.add('paused');
            }, { passive: true });

            reviewsContainer.addEventListener('touchend', function() {
                reviewsTrack.classList.remove('paused');
            }, { passive: true });
        }
    });

    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        if (navbar) {
            if (window.scrollY > 30) {
                navbar.classList.add('shadow-md');
            } else {
                navbar.classList.remove('shadow-md');
            }
        }
    });
</script>
