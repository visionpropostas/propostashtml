    function calculateSimulator() {
        let baseEquipCost = 129090; 
        if(currentSimMode === 'card') baseEquipCost = 154895.09;
        if(currentSimMode === 'opex48') baseEquipCost = 222276.96; // 48x 4630.77

        let monthlyCareCost = 0;
        if(currentSimCare === 'business') monthlyCareCost = 1800;
        if(currentSimCare === 'enterprise') monthlyCareCost = 2500;

        const totalCare48 = monthlyCareCost * 48;
        const grandTotal = baseEquipCost + totalCare48;
        const competitorTotal = 270000;
        const savings = competitorTotal - grandTotal;
        const savingsPct = ((savings / competitorTotal) * 100).toFixed(1);

        document.getElementById('sim-total-display').innerText = 'R$ ' + grandTotal.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        document.getElementById('sim-monthly-breakdown').innerText = `Equipamentos R$ ${baseEquipCost.toLocaleString('pt-BR')} + Care R$ ${monthlyCareCost}/mês (x48)`;
        
        const savingsElem = document.getElementById('sim-savings-display');
        const savingsPctElem = document.getElementById('sim-savings-percent');

        if(savings >= 0) {
            savingsElem.innerText = 'R$ ' + savings.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            savingsPctElem.innerText = `Economia de ${savingsPct}% em relação aos R$ 270.000,00 do concorrente`;
            savingsElem.className = "text-2xl md:text-3xl font-extrabold text-emerald-400 block mt-0.5";
        } else {
            const extra = Math.abs(savings);
            savingsElem.innerText = '+ R$ ' + extra.toLocaleString('pt-BR', {minimumFractionDigits: 2});
            savingsPctElem.innerText = `Diferença por optar por suporte Enterprise 24/7 de alta frequência`;
            savingsElem.className = "text-2xl md:text-3xl font-extrabold text-amber-400 block mt-0.5";
        }
    }

