                setTimeout(() => { if(selectContainer) selectContainer.classList.add('hidden'); }, 200);
            }
        } else if (mode === 'parcelado') {
            if (bg) bg.style.transform = 'translateX(100%)';
            if (btnParcelado) {
                btnParcelado.classList.remove('text-gray-500');
                btnParcelado.classList.add('text-gray-900');
            }
            if (selectContainer) {
                selectContainer.classList.remove('hidden');
                setTimeout(() => { if(selectContainer) selectContainer.classList.remove('opacity-0', 'pointer-events-none'); }, 10);
            }
        }

        updatePrices();
    }

    function updateWhatsAppLink() {
        const btnLink = document.getElementById('btn-aprova-link');
        if (!btnLink) return;

        let message = '';
        const tvipTxt = includeTvip ? ' COM o Monitor TVIP no Balcão' : ' no formato enxuto com InControl Web no computador';

        if (currentPaymentMode === 'avista') {
            const finalPix = pricingData.pixBase + (includeTvip ? pricingData.tvipPix : 0);
            message = `Fala Gabriel, analisei a proposta da Escola de Yoga (Cônego Eugênio Leite, 881)${tvipTxt} e gostaria de aprovar o projeto com pagamento à Vista de R$ ${formatExactCurrency(finalPix)} via PIX.`;
        } else {
            const select = document.getElementById('installment-select');
            const installments = select ? parseInt(select.value) : 12;
            
            let totalVal = pricingData.cardTotalBase + (includeTvip ? pricingData.tvipCard : 0);
            if (installments < 12) {
                const pixVal = pricingData.pixBase + (includeTvip ? pricingData.tvipPix : 0);
                const factor = 1 + ((1.1999 - 1) * (installments / 12));
                totalVal = pixVal * factor;
            }
            const instVal = totalVal / installments;

            message = `Fala Gabriel, analisei a proposta da Escola de Yoga (Cônego Eugênio Leite, 881)${tvipTxt} e gostaria de aprovar o projeto parcelado em ${installments}x de R$ ${formatExactCurrency(instVal)} no cartão.`;
        }

        btnLink.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(message);
    }

    function updatePrices() {
        const priceContainer = document.getElementById('price-opt1');
        const select = document.getElementById('installment-select');
        if (!priceContainer) return;

        const effectivePix = pricingData.pixBase + (includeTvip ? pricingData.tvipPix : 0);
        const effectiveCardTotal = pricingData.cardTotalBase + (includeTvip ? pricingData.tvipCard : 0);

        if (currentPaymentMode === 'avista') {
            const signal = effectivePix / 2;
            priceContainer.innerHTML = `
                <div class="flex flex-col items-center w-full animate-fade-in font-sans">
                    <p class="text-[8px] md:text-[10px] text-[#8a6208] uppercase tracking-widest font-bold mb-1">À Vista no PIX (Sem Juros)${includeTvip ? ' • COM TVIP' : ''}</p>
                    <span class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-4">R$ ${formatExactCurrency(effectivePix)}</span>
                    
                    <div class="w-full space-y-2">
                        <div class="bg-white border border-gray-200 rounded-xl py-2.5 flex flex-col items-center justify-center relative overflow-hidden shadow-sm">
                            <div class="absolute top-0 left-0 w-1 h-full bg-[#34d399] rounded-l-lg"></div>
                            <span class="text-[8px] font-bold uppercase tracking-widest text-brand-goldDark mb-0.5 font-sans">Sinal para Compra dos Equipamentos (50%)</span>
                            <span class="text-sm font-bold text-gray-900">R$ ${formatExactCurrency(signal)}</span>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-xl py-2.5 flex flex-col items-center justify-center relative overflow-hidden shadow-sm">
                            <div class="absolute top-0 left-0 w-1.5 h-full bg-[#c8a048] rounded-l-lg"></div>
                            <span class="text-[8px] font-bold uppercase tracking-widest text-brand-goldDark mb-0.5 font-sans">Saldo na Entrega e Treinamento do InControl Web (50%)</span>
                            <span class="text-sm font-bold text-gray-900">R$ ${formatExactCurrency(signal)}</span>
                        </div>
                    </div>
                </div>
            `;
        } else {
            const inst = parseInt(select ? select.value : '12');
            let totalVal = effectiveCardTotal;
            if (inst < 12) {
                const factor = 1 + ((1.1999 - 1) * (inst / 12));
                totalVal = effectivePix * factor;
            }
            const instVal = totalVal / inst;

            priceContainer.innerHTML = `
                <div class="flex flex-col items-center w-full mt-2 mb-2 animate-fade-in font-sans">
                    <div class="flex items-baseline justify-center gap-1.5 mb-2">
                        <span class="text-xl md:text-2xl font-bold text-brand-yellow">${inst}x de R$</span> 
                        <span class="text-4xl md:text-5xl font-black text-gray-900">${formatExactCurrency(instVal)}</span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 bg-blue-50 border border-blue-200 text-blue-700 px-3 py-1 rounded-full w-fit shadow-sm mt-2 mb-3 font-sans">
                        <i data-lucide="credit-card" class="w-4 h-4"></i>
                        <span class="text-[10px] md:text-[11px] font-bold uppercase tracking-widest">Cartão de Crédito (Sem Imobilizar o Caixa)</span>
                    </div>
                    <p class="text-[10px] text-gray-500 font-medium font-sans">Total Parcelado: R$ ${formatExactCurrency(totalVal)}</p>
                </div>
            `;
        }

        updateWhatsAppLink();
        initIcons();
    }

    document.addEventListener("DOMContentLoaded", () => {
        setPaymentMode('avista');
    });
    window.addEventListener("load", () => {
        updatePrices();
    });

    try {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    } catch(e) {
        document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
    }

    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        const ctaFloat = document.getElementById('cta-float');
        
        if (window.scrollY > 50) {
            if(navbar) navbar.classList.add('shadow-md');
        } else {
            if(navbar) navbar.classList.remove('shadow-md');
        }

        if (window.scrollY > 400) {
            if(ctaFloat) {
                ctaFloat.classList.remove('opacity-100', 'translate-y-0');
                ctaFloat.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }
        }
    });

    let ytPlayer = null;

    function onYouTubeIframeAPIReady() {
        try {
            ytPlayer = new YT.Player('youtube-player', {
                events: {
                    'onReady': onPlayerReady
                }
            });
        } catch(e) {
            console.log('YouTube API carregada com fallback direto.');
        }
    }

    function onPlayerReady(event) {
        try {
            event.target.mute();
            event.target.playVideo();
        } catch(e) {}
    }

    function unmuteYoutube() {
        const overlay = document.getElementById("unmute-overlay");
        if (overlay) {
            overlay.style.opacity = "0";
            setTimeout(() => { overlay.style.display = "none"; }, 300);
        }
        if (ytPlayer && typeof ytPlayer.unMute === 'function') {
            try {
                ytPlayer.unMute();
                ytPlayer.playVideo();
            } catch(e) {}
        }
        if (window.clarity) {
            try { window.clarity("event", "Video_Demonstracao_SS3532_Assistido"); } catch(err){}
        }
    }
</script>
</body>
</html>
