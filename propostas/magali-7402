        installment12: 1048.91,
        comercial: 1190,
        comercialExtra: 590,
        hibrido: 1290,
        hibridoExtra: 490,
        total24h: 1990
    };

    let currentPaymentMode = 'avista';

    // Inicialização dos ícones Lucide
    function initIcons() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            try {
                window.lucide.createIcons();
            } catch(e) {}
        }
    }

    document.addEventListener('DOMContentLoaded', initIcons);

    // Validação da Senha
    function checkPassword() {
        const inputEl = document.getElementById('password-input');
        if (!inputEl) return;

        const val = inputEl.value.trim().toUpperCase();
        const validPasswords = ['MAGALI2026', 'MIRAMAR', 'VISION', 'MAGALI', 'ASSUNCAO', 'SBC', 'VALTER'];
        const errorEl = document.getElementById('error-msg');
        const btnUnlock = document.getElementById('btn-unlock');

        if (validPasswords.includes(val)) {
            if (btnUnlock) btnUnlock.innerHTML = '<span class="animate-pulse">Liberando acesso...</span>';

            setTimeout(() => {
                const lockScreen = document.getElementById('lock-screen');
                if (lockScreen) lockScreen.style.opacity = '0';

                // GA4 & Clarity Tracking
                if (typeof gtag === 'function') {
                    try {
                        gtag('event', 'proposta_desbloqueada', { cliente: 'Magali Munhos - Cid Miramar' });
                    } catch(e) {}
                }
                if (window.clarity && typeof window.clarity === 'function') {
                    try {
                        window.clarity("event", "Proposta_Desbloqueada_Miramar");
                    } catch(e) {}
                }

                // Alerta silencioso StaticForms
                try {
                    fetch('https://api.staticforms.dev/submit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            accessKey: "sf_077ej49gjha153gk3m6ceecf",
                            subject: "🚨 ALERTA: Proposta Desbloqueada (Magali - Cid Miramar SBC)",
                            message: "A síndica Magali desbloqueou a proposta dos 9 portões.\nSenha usada: " + val
                        })
                    }).catch(() => {});
                } catch(e) {}

                setTimeout(() => {
                    if (lockScreen) lockScreen.style.display = 'none';
                    document.getElementById('html-root').classList.remove('overflow-hidden', 'h-screen');
                    document.body.classList.remove('overflow-hidden', 'h-screen');
                    initIcons();
                }, 500);

            }, 400);

        } else {
            if (errorEl) errorEl.classList.remove('hidden');
            inputEl.classList.add('border-red-500');
            setTimeout(() => {
                if (errorEl) errorEl.classList.add('hidden');
                inputEl.classList.remove('border-red-500');
            }, 3000);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const pwdInput = document.getElementById('password-input');
        if (pwdInput) {
            pwdInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });
        }
    });

    // Accordion FAQ
    function toggleAccordion(btn) {
        const item = btn.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
    }

    function formatNumber(val) {
        return Math.round(val).toLocaleString('pt-BR');
    }

    // Toggle de Pagamento da Obra
    function setPaymentMode(mode) {
        currentPaymentMode = mode;
        const bg = document.getElementById('toggle-bg');
        const btnAvista = document.getElementById('btn-avista');
        const btnParcelado = document.getElementById('btn-parcelado');
        const selectContainer = document.getElementById('installment-container');

        if (mode === 'avista') {
            if (bg) bg.style.transform = 'translateX(0)';
            if (btnAvista) {
                btnAvista.classList.remove('text-zinc-500');
                btnAvista.classList.add('text-zinc-950');
            }
            if (btnParcelado) {
                btnParcelado.classList.remove('text-zinc-950');
                btnParcelado.classList.add('text-zinc-500');
            }
            if (selectContainer) {
                selectContainer.classList.add('opacity-0', 'pointer-events-none');
                setTimeout(() => selectContainer.classList.add('hidden'), 200);
            }
        } else {
            if (bg) bg.style.transform = 'translateX(100%)';
            if (btnParcelado) {
                btnParcelado.classList.remove('text-zinc-500');
                btnParcelado.classList.add('text-zinc-950');
            }
            if (btnAvista) {
                btnAvista.classList.remove('text-zinc-950');
                btnAvista.classList.add('text-zinc-500');
            }
            if (selectContainer) {
                selectContainer.classList.remove('hidden');
                setTimeout(() => selectContainer.classList.remove('opacity-0', 'pointer-events-none'), 10);
            }
        }

        updatePrices();
    }

    function updatePrices() {
        const container = document.getElementById('price-opt1');
        const select = document.getElementById('installment-select');
        const btnLink = document.getElementById('btn-aprova-link');
        if (!container) return;

        if (currentPaymentMode === 'avista') {
            container.innerHTML = `
                <div class="flex items-center justify-center gap-2 mb-1">
                    <span class="text-xs text-zinc-400 line-through">De R$ ${formatNumber(pricingData.cardTotal)}</span>
                    <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded-full">
                        Economia de R$ 2.097 no PIX
                    </span>
                </div>
                <div class="flex items-baseline justify-center gap-1">
                    <span class="text-sm font-bold text-zinc-500">Por</span>
                    <span class="text-4xl sm:text-5xl font-black text-zinc-950 tracking-tight">R$ ${formatNumber(pricingData.pixExact)}</span>
                    <span class="text-xs font-bold text-zinc-500">à vista</span>
                </div>
                <div class="grid grid-cols-2 gap-2 mt-3 pt-3 border-t border-zinc-100 text-xs">
                    <div class="bg-zinc-50 p-2 rounded-xl text-center">
                        <span class="text-[10px] text-zinc-400 block font-bold">Entrada (Sinal 50%)</span>
                        <strong class="text-zinc-900 font-extrabold">R$ 5.245,00</strong>
                    </div>
                    <div class="bg-zinc-50 p-2 rounded-xl text-center">
                        <span class="text-[10px] text-zinc-400 block font-bold">Entrega da Obra (50%)</span>
                        <strong class="text-zinc-900 font-extrabold">R$ 5.245,00</strong>
                    </div>
                </div>
            `;

            if (btnLink) {
                const msg = `Olá Gabriel, analisei a proposta dos 9 portões no Condomínio Cid Miramar e gostaríamos de aprovar a obra à Vista no valor de R$ ${formatNumber(pricingData.pixExact)} via PIX (50% sinal e 50% na conclusão), alinhando também o plano de manutenção mensal.`;
                btnLink.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(msg);
            }

        } else {
            const inst = parseInt(select ? select.value : '12');
            let totalVal = pricingData.cardTotal;
            if (inst < 12) {
                const factor = 1 + ((1.1999 - 1) * (inst / 12));
                totalVal = Math.round(pricingData.pixExact * factor);
            }
            const instVal = Math.round(totalVal / inst);

            container.innerHTML = `
                <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Parcelado no Cartão do Condomínio</span>
                <div class="flex items-baseline justify-center gap-1.5">
                    <span class="text-lg font-bold text-brand-yellow">${inst}x de</span>
                    <span class="text-4xl sm:text-5xl font-black text-zinc-950 tracking-tight">R$ ${formatNumber(instVal)}</span>
                </div>
                <span class="text-xs text-zinc-500 mt-2 block">Total no cartão: R$ ${formatNumber(totalVal)}</span>
            `;

            if (btnLink) {
                const msg = `Olá Gabriel, analisei a proposta dos 9 portões no Condomínio Cid Miramar e gostaríamos de aprovar a obra parcelada em ${inst}x de R$ ${formatNumber(instVal)} no cartão, alinhando também o plano de manutenção mensal.`;
                btnLink.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(msg);
            }
        }
    }

    // Lead tracking
    function trackLeadConversion(label) {
        if (typeof gtag === 'function') {
            try {
                gtag('event', 'generate_lead', { event_label: label, cliente: 'Magali Munhos - Cid Miramar' });
            } catch(e) {}
        }
        if (window.clarity && typeof window.clarity === 'function') {
            try {
                window.clarity("event", "Clique_WhatsApp_" + label.replace(/\s+/g, '_'));
            } catch(e) {}
        }
    }

    window.addEventListener("load", () => {
        setPaymentMode('avista');
    });
</script>

