<!-- ===================== SCRIPTS ===================== -->
<script>
    // Impressão protegida contra bloqueios de iframe
    function safePrint() {
        try {
            window.print();
        } catch (err) {
            console.warn('Impressão indisponível no ambiente:', err);
        }
    }

    // Inicialização dos ícones Lucide
    function initIcons() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            try {
                window.lucide.createIcons();
            } catch (err) {
                console.warn('Erro ao carregar ícones:', err);
            }
        }
    }
    document.addEventListener("DOMContentLoaded", initIcons);

    // VALIDAÇÃO DA SENHA CORPORATIVA (VETEX2026 / VETEX / PAMELA / VISION)
    function checkPassword() {
        const inputEl = document.getElementById('password-input');
        if (!inputEl) return;

        const input = inputEl.value;
        const errorMsg = document.getElementById('error-msg');
        const formattedInput = input.trim().toUpperCase();
        
        const btnUnlock = document.getElementById('btn-unlock');
        const unlockIcon = document.getElementById('unlock-icon');
        const unlockText = document.getElementById('unlock-text');
        const unlockArrow = document.getElementById('unlock-arrow');
        
        const validPasswords = ['VETEX2026', 'VETEX', 'PAMELA', 'VISION'];

        if (validPasswords.includes(formattedInput)) {
            if (btnUnlock) btnUnlock.disabled = true;
            if (unlockText) unlockText.textContent = "A Validar Acesso...";
            if (unlockIcon) unlockIcon.className = "w-5 h-5 animate-spin text-black";
            if (unlockArrow) unlockArrow.style.display = 'none';

            setTimeout(() => {
                const lockScreen = document.getElementById('lock-screen');
                if (lockScreen) lockScreen.style.opacity = '0';

                const video = document.getElementById("vision-video");
                if (video && video.paused) {
                    video.muted = true;
                    video.play().catch(e => {});
                }

                if (window.clarity) {
                    try {
                        window.clarity("consent");
                        window.clarity("identify", "pamela-vetex", undefined, undefined, "Pamela (VETEX SÃO PAULO)");
                        window.clarity("set", "Proposta", "Projeto_Expansao_CFTV_VETEX");
                        window.clarity("event", "Proposta_Desbloqueada");
                    } catch(e){}
                }

                fetch('https://api.staticforms.dev/submit', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        accessKey: "sf_077ej49gjha153gk3m6ceecf",
                        subject: "🚨 ALERTA: Proposta Acessada (Pamela - VETEX SP)",
                        name: "Sistema Vision",
                        email: "diretoria@visionsp.com.br",
                        message: "A cliente Pamela acabou de abrir o projeto de expansão do escritório VETEX em Vila Leopoldina!\n\n👤 Cliente: Pamela (VETEX SP)\n🔑 Senha Utilizada: " + input + "\n🕒 Horário: " + new Date().toLocaleString('pt-BR')
                    })
                }).catch(() => console.log('Registro de log local mantido.'));

                setTimeout(() => { 
                    if (lockScreen) lockScreen.style.display = 'none'; 
                    const htmlRoot = document.getElementById('html-root');
                    if (htmlRoot) {
                        htmlRoot.classList.remove('overflow-hidden', 'h-screen');
                        htmlRoot.classList.add('overflow-x-hidden');
                    }
                    document.body.classList.remove('overflow-hidden', 'h-screen');
                }, 700);

            }, 800);

        } else {
            if (errorMsg) errorMsg.classList.remove('hidden');
            inputEl.style.borderColor = 'rgba(239,68,68,0.5)';
            setTimeout(() => {
                if (errorMsg) errorMsg.classList.add('hidden');
                inputEl.style.borderColor = '';
            }, 3000);
        }
    }

    // ENTER KEY ON PASSWORD INPUT
    document.addEventListener("DOMContentLoaded", () => {
        const pwdInput = document.getElementById('password-input');
        if (pwdInput) {
            pwdInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });
        }
    });

    // ACCORDION TOGGLE
    function toggleAccordion(button) {
        const item = button.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
    }

    // MEMÓRIA DE CÁLCULO FINANCEIRO EXATO (TIER 2 NORMAL — DIVISOR 0.685)
    // SEM VALORES ARREDONDADOS ARBITRÁRIOS E SEM ZEROS DESNECESSÁRIOS
    const pricingData = {
        hasPorts: {
            ctd: 2491.45,
            pixExact: 3637.15, // 2491.45 / 0.685 = 3637.15328... -> 3637.15
            cardTotal: 4364.22, // 3637.15328... * 1.1999 = 4364.2202... -> 4364.22
            installment12: 363.68 // 4364.22 / 12 = 363.685 -> 363.68
        },
        noPorts: {
            ctd: 3155.51,
            pixExact: 4606.58, // 3155.51 / 0.685 = 4606.5839... -> 4606.58
            cardTotal: 5527.44, // 4606.5839... * 1.1999 = 5527.439... -> 5527.44
            installment12: 460.62 // 5527.44 / 12 = 460.62
        }
    };

    let currentSwitchMode = 'hasPorts'; // 'hasPorts' vs 'noPorts'
    let currentPaymentMode = 'avista'; // 'avista' vs 'parcelado'

    function formatExactCurrency(val) {
        return val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function setSwitchMode(mode) {
        currentSwitchMode = mode;
        const btnYes = document.getElementById('btn-switch-yes');
        const btnNo = document.getElementById('btn-switch-no');
        const switchLineItem = document.getElementById('switch-line-item');

        if (mode === 'hasPorts') {
            if (btnYes) {
                btnYes.className = "p-3.5 rounded-xl border text-left transition-all font-sans cursor-pointer bg-white border-brand-yellow shadow-sm";
            }
            if (btnNo) {
                btnNo.className = "p-3.5 rounded-xl border text-left transition-all font-sans cursor-pointer bg-gray-100 border-gray-200 opacity-70 hover:opacity-100";
            }
            if (switchLineItem) switchLineItem.classList.add('hidden');
        } else {
            if (btnNo) {
                btnNo.className = "p-3.5 rounded-xl border text-left transition-all font-sans cursor-pointer bg-white border-brand-yellow shadow-sm";
            }
            if (btnYes) {
                btnYes.className = "p-3.5 rounded-xl border text-left transition-all font-sans cursor-pointer bg-gray-100 border-gray-200 opacity-70 hover:opacity-100";
            }
            if (switchLineItem) switchLineItem.classList.remove('hidden');
        }

        updatePrices();
    }

    function setPaymentMode(mode) {
        currentPaymentMode = mode;
        const bg = document.getElementById('toggle-bg');
        const btnPix = document.getElementById('btn-avista');
        const btnParcelado = document.getElementById('btn-parcelado');
        const selectContainer = document.getElementById('installment-container');

        if (mode === 'avista') {
            if (bg) bg.style.transform = 'translateX(0)';
            if (btnPix) {
                btnPix.classList.remove('text-gray-500');
                btnPix.classList.add('text-gray-900');
            }
            if (btnParcelado) {
                btnParcelado.classList.remove('text-gray-900');
                btnParcelado.classList.add('text-gray-500');
            }
            if (selectContainer) {
                selectContainer.classList.add('opacity-0', 'pointer-events-none');
                setTimeout(() => { if(selectContainer) selectContainer.classList.add('hidden'); }, 300);
            }
        } else {
            if (bg) bg.style.transform = 'translateX(100%)';
            if (btnParcelado) {
                btnParcelado.classList.remove('text-gray-500');
                btnParcelado.classList.add('text-black');
            }
            if (btnPix) {
                btnPix.classList.remove('text-black');
                btnPix.classList.add('text-gray-500');
            }
            if (selectContainer) {
                selectContainer.classList.remove('hidden');
                setTimeout(() => { if(selectContainer) selectContainer.classList.remove('opacity-0', 'pointer-events-none'); }, 10);
            }
        }

        updatePrices();
    }

    function updateWhatsAppLink() {
        const btnLink = document.getElementById('btn-aprova-link');
        if (!btnLink) return;

        const currentData = pricingData[currentSwitchMode];
        let message = '';

        if (currentPaymentMode === 'avista') {
            message = `Olá Gabriel, analisei a proposta de expansão das 5 câmeras da VETEX e gostaríamos de aprovar o projeto com pagamento à Vista de R$ ${formatExactCurrency(currentData.pixExact)} via PIX.`;
            if (currentSwitchMode === 'noPorts') {
                message += ` (Incluindo o Switch Intelbras SF 900 Hi-PoE).`;
            } else {
                message += ` (Utilizando as portas PoE vagas no nosso switch atual).`;
            }
        } else {
            const select = document.getElementById('installment-select');
            const installments = select ? parseInt(select.value) : 12;
            
            let totalVal = currentData.cardTotal;
            if (installments < 12) {
                // Cálculo proporcional simples se for em menos parcelas
                const pixVal = currentData.pixExact;
                const factor = 1 + ((1.1999 - 1) * (installments / 12));
                totalVal = pixVal * factor;
            }
            const instVal = totalVal / installments;

            message = `Olá Gabriel, analisei a proposta de expansão das 5 câmeras da VETEX e gostaríamos de aprovar o projeto parcelado em ${installments}x de R$ ${formatExactCurrency(instVal)} no cartão de crédito.`;
            if (currentSwitchMode === 'noPorts') {
                message += ` (Incluindo o Switch Intelbras SF 900 Hi-PoE).`;
            } else {
                message += ` (Utilizando as portas PoE vagas no nosso switch atual).`;
            }
        }

        btnLink.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(message);
    }

    function updatePrices() {
        const priceContainer = document.getElementById('price-opt1');
        const select = document.getElementById('installment-select');
        if (!priceContainer) return;

        const data = pricingData[currentSwitchMode];

        if (currentPaymentMode === 'avista') {
            priceContainer.innerHTML = `
                <div class="flex flex-col items-center w-full animate-fade-in font-sans">
                    <p class="text-[8px] md:text-[10px] text-[#8a6208] uppercase tracking-widest font-bold mb-1">À Vista no PIX (Sem Juros)</p>
                    <span class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-2">R$ ${formatExactCurrency(data.pixExact)}</span>
                    <p class="text-[10px] text-gray-500 font-medium font-sans">Fornecimento de 5 Câmeras IP Dome + Infraestrutura + Mão de Obra</p>
                </div>
            `;
        } else {
            const inst = parseInt(select ? select.value : '12');
            let totalVal = data.cardTotal;
            if (inst < 12) {
                const pixVal = data.pixExact;
                const factor = 1 + ((1.1999 - 1) * (inst / 12));
                totalVal = pixVal * factor;
            }
            const instVal = totalVal / inst;

            priceContainer.innerHTML = `
                <div class="flex flex-col items-center w-full mt-2 mb-2 animate-fade-in font-sans">
                    <div class="flex items-baseline justify-center gap-1.5 mb-2">
                        <span class="text-xl md:text-2xl font-bold text-brand-yellow">${inst}x de R$</span> 
                        <span class="text-4xl md:text-5xl font-black text-gray-900">${formatExactCurrency(instVal)}</span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 bg-blue-50 border border-blue-200 text-blue-700 px-3 py-1 rounded-full w-fit shadow-sm mt-2 mb-3 font-sans">
                        <i data-lucide="credit-card" class="w-4 h-4"></i>
                        <span class="text-[10px] md:text-[11px] font-bold uppercase tracking-widest">Cartão de Crédito Coletivo/Corporativo</span>
                    </div>
                    <p class="text-[10px] text-gray-500 font-medium font-sans">Total Parcelado: R$ ${formatExactCurrency(totalVal)}</p>
                </div>
            `;
        }

        updateWhatsAppLink();
        initIcons();
    }

    // INITIAL LOAD
    window.addEventListener("load", () => {
        setSwitchMode('hasPorts');
        setPaymentMode('avista');
    });

    // INTERSECTION OBSERVER REVEAL
    try {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    } catch(e) {
        document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
    }

    // SCROLL LISTENERS
    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        const ctaFloat = document.getElementById('cta-float');
        
        if (window.scrollY > 50) {
            if(navbar) navbar.classList.add('shadow-md');
        } else {
            if(navbar) navbar.classList.remove('shadow-md');
        }

        if (window.scrollY > 400) {
            if(ctaFloat) {
                ctaFloat.classList.remove('hidden', 'opacity-0', 'translate-y-10', 'pointer-events-none');
                ctaFloat.classList.add('opacity-100', 'translate-y-0');
            }
        } else {
            if(ctaFloat) {
                ctaFloat.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }
        }
    });

    // MEDIA PLAYER CONTROLS
    document.addEventListener("DOMContentLoaded", function() {
        const video = document.getElementById("vision-video");
        const overlay = document.getElementById("unmute-overlay");
        if (video && overlay) {
            overlay.addEventListener("click", function(e) {
                e.stopPropagation(); 
                video.muted = false;
                video.loop = true; 
                video.currentTime = 0;
                video.play().catch(err => {});
                overlay.style.opacity = "0";
                setTimeout(() => { overlay.style.display = "none"; }, 500); 

                if (window.clarity) {
                    try { window.clarity("event", "Video_Assistido_VisionVideo_VETEX"); } catch(err){}
                }
            });
            video.addEventListener("click", function() {
                if (overlay.style.display === "none") {
                    if (video.paused) { video.play(); } else { video.pause(); }
                }
            });
        }
    });
</script>
