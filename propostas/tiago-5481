        }

        renderPriceDisplay();
        if (window.clarity) window.clarity("event", "Mudou_Pagamento_Tiago_" + paymentMode);
    }

    function renderPriceDisplay() {
        const box = document.getElementById('price-display-box');
        const ctaBtn = document.getElementById('btn-whatsapp-cta');
        const ctaText = document.getElementById('cta-btn-text');

        if (!box) return;

        let html = '';
        let whatsappMsg = '';

        if (selectedPayment === 'pix') {
            html = `
                <div class="flex flex-col items-center justify-center w-full animate-fade-in">
                    <div class="flex items-baseline justify-center gap-1.5 mb-2">
                        <span class="text-2xl font-bold text-gray-400">R$</span>
                        <span class="text-5xl md:text-6xl font-extrabold text-[#111827] tracking-tighter leading-none">${formatBRL(pricing.pix).split(',')[0]}<span class="text-3xl text-gray-400">,${formatBRL(pricing.pix).split(',')[1]}</span></span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 text-emerald-700 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest mt-2">
                        <i data-lucide="zap" class="w-3 h-3"></i> Pagamento à vista (PIX)
                    </div>
                    
                    <div class="w-full mt-6 space-y-2 text-left">
                        <div class="bg-white border border-gray-200 rounded-xl p-3 shadow-sm relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-1.5 h-full bg-emerald-400"></div>
                            <div class="pl-2">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-gray-500 block">Sinal (Aprovação e Pedido de Equipamentos)</span>
                                <span class="font-bold text-gray-900 text-sm">R$ ${formatBRL(pricing.pixHalf)}</span>
                            </div>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-xl p-3 shadow-sm relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-1.5 h-full bg-brand-yellow"></div>
                            <div class="pl-2">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-gray-500 block">Entrega (Finalização, Testes no App &amp; Garantia)</span>
                                <span class="font-bold text-gray-900 text-sm">R$ ${formatBRL(pricing.pixHalf)}</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            whatsappMsg = `Fala Gabriel! Vi a proposta técnica completa do apartamento na Rua Visconde de Nacar (10 Câmeras IP, Switches PoE, Wi-Fi 6 Mesh e NVR com 2TB). Gostaria de aprovar a proposta no valor de *R$ ${formatBRL(pricing.pix)} no PIX*. Vamos alinhar os detalhes da nossa visita de sexta de manhã!`;
            if (ctaText) ctaText.textContent = `Aprovar no PIX (R$ ${formatBRL(pricing.pix)})`;

        } else {
            html = `
                <div class="flex flex-col items-center justify-center w-full animate-fade-in">
                    <span class="text-xs font-bold text-gray-400 mb-1">Parcelamento Facilitado</span>
                    <div class="flex items-baseline justify-center gap-1.5 mb-3">
                        <span class="text-2xl font-bold text-[#111827]">12x de R$</span>
                        <span class="text-5xl md:text-6xl font-extrabold text-[#111827] tracking-tighter leading-none">${formatBRL(pricing.cardMonthly).split(',')[0]}<span class="text-3xl text-gray-400">,${formatBRL(pricing.cardMonthly).split(',')[1]}</span></span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 bg-blue-50 border border-blue-200 text-blue-700 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest mt-1">
                        <i data-lucide="credit-card" class="w-3 h-3"></i> Cartão de Crédito
                    </div>
                    <p class="text-xs text-gray-500 font-medium mt-4">Valor total parcelado: R$ ${formatBRL(pricing.cardTotal)}</p>
                </div>
            `;
            whatsappMsg = `Fala Gabriel! Analisei a proposta dos 10 pontos de CFTV IP e rede Wi-Fi 6 Mesh para o apartamento do Morumbi. Gostaria de aprovar o projeto em *12x de R$ ${formatBRL(pricing.cardMonthly)} no cartão*. Vamos combinar os detalhes para a visita de sexta de manhã!`;
            if (ctaText) ctaText.textContent = `Aprovar em 12x no Cartão`;
        }

        box.innerHTML = html;
        if (ctaBtn) ctaBtn.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(whatsappMsg);
        
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }

    // ACCORDION TOGGLE
    function toggleAccordion(button) {
        const item = button.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }

    // CONTROLE DE ACESSO (LOCK SCREEN)
    function checkPassword() {
        const inputEl = document.getElementById('password-input');
        if (!inputEl) return;

        const input = inputEl.value.trim().toUpperCase();
        const errorMsg = document.getElementById('error-msg');
        const btnUnlock = document.getElementById('btn-unlock');
        const unlockIcon = document.getElementById('unlock-icon');
        const unlockText = document.getElementById('unlock-text');
        const unlockArrow = document.getElementById('unlock-arrow');

        const validPasswords = ['TIAGO2026', 'TIAGO', 'MORUMBI', 'VISION'];

        if (validPasswords.includes(input)) {
            if (btnUnlock) btnUnlock.disabled = true;
            if (unlockText) unlockText.textContent = "Validando Acesso...";
            if (unlockIcon) unlockIcon.className = "w-5 h-5 animate-spin text-black";
            if (unlockArrow) unlockArrow.style.display = 'none';

            setTimeout(() => {
                const lockScreen = document.getElementById('lock-screen');
                if (lockScreen) lockScreen.style.opacity = '0';

                const video = document.getElementById("vision-video");
                if (video && video.paused) {
                    video.muted = true;
                    video.play().catch(() => {});
                }

                if (window.clarity) {
                    try {
                        window.clarity("consent");
                        window.clarity("identify", "tiago-morumbi", undefined, undefined, "Tiago (Morumbi 300m2)");
                        window.clarity("set", "Proposta", "Projeto_CFTV_IP_Tiago");
                        window.clarity("event", "Proposta_Desbloqueada");
                    } catch(e) {}
                }

                // Notificação silenciosa de abertura
                fetch('https://api.staticforms.dev/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        accessKey: "sf_077ej49gjha153gk3m6ceecf",
                        subject: "🚨 ALERTA: Proposta Acessada (Tiago - Morumbi 300 m²)",
                        name: "Sistema Vision",
                        email: "diretoria@visionsp.com.br",
                        message: "O cliente Tiago acessou a proposta técnica definitiva de 10 Câmeras IP + Wi-Fi 6 Mesh no Morumbi!\n\n🔑 Senha Utilizada: " + input + "\n🕒 Horário: " + new Date().toLocaleString('pt-BR')
                    })
                }).catch(() => {});

                setTimeout(() => {
                    if (lockScreen) lockScreen.style.display = 'none';
                    const htmlRoot = document.getElementById('html-root');
                    if (htmlRoot) {
                        htmlRoot.classList.remove('overflow-hidden', 'h-screen');
                        htmlRoot.classList.add('overflow-x-hidden');
                    }
                    document.body.classList.remove('overflow-hidden', 'h-screen');
                    document.body.classList.add('overflow-x-hidden');
                }, 700);

            }, 600);

        } else {
            if (errorMsg) errorMsg.classList.remove('hidden');
            inputEl.style.borderColor = 'rgba(239,68,68,0.5)';
            setTimeout(() => {
                if (errorMsg) errorMsg.classList.add('hidden');
                inputEl.style.borderColor = '';
            }, 3000);
        }
    }

    // INICIALIZAÇÃO
    document.addEventListener("DOMContentLoaded", function() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }

        const pwdInput = document.getElementById('password-input');
        if (pwdInput) {
            pwdInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });
        }

        // Scroll Reveal
        try {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('active');
                });
            }, { threshold: 0.08 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        } catch(e) {
            document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
        }

        // Vídeo e Áudio
        const videoHero = document.getElementById("vision-video");
        const overlayHero = document.getElementById("unmute-overlay");

        if (videoHero && overlayHero) {
            overlayHero.addEventListener("click", function(e) {
                e.stopPropagation();
                videoHero.muted = false;
                videoHero.loop = true;
                videoHero.currentTime = 0;
                videoHero.play().catch(() => {});
                overlayHero.style.opacity = "0";
                setTimeout(() => { overlayHero.style.display = "none"; }, 400);

                if (window.clarity) {
                    try { window.clarity("event", "Video_Assistido_Tiago"); } catch(err) {}
                }
            });

            videoHero.addEventListener("click", function() {
                if (overlayHero.style.display === "none") {
                    if (videoHero.paused) { videoHero.play(); } else { videoHero.pause(); }
                }
            });
        }

        // Renderização inicial
        renderPriceDisplay();

        // Pausa no Carrossel com Touch
        const reviewsTrack = document.getElementById('reviews-track');
        const reviewsContainer = document.getElementById('reviews-container');
        if (reviewsTrack && reviewsContainer) {
            reviewsContainer.addEventListener('touchstart', function() {
                reviewsTrack.classList.add('paused');
            }, { passive: true });

            reviewsContainer.addEventListener('touchend', function() {
                reviewsTrack.classList.remove('paused');
            }, { passive: true });

            reviewsContainer.addEventListener('touchcancel', function() {
                reviewsTrack.classList.remove('paused');
            }, { passive: true });
        }
    });

    // Navbar Scroll Shadow
    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        if (navbar) {
            if (window.scrollY > 40) {
                navbar.classList.add('shadow-md');
            } else {
                navbar.classList.remove('shadow-md');
            }
        }
    });
</script>
