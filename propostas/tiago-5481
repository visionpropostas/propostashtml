<script>
    // DADOS FINANCEIROS EXATOS (ORÇAMENTO DEFINITIVO TIAGO - BASE SPEED Nº 181.840)
    // CTD: R$ 10.109,63 (Materiais R$ 8.349,63 + Repasse M.O. R$ 1.760,00)
