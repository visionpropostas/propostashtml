                    <span class="absolute -right-3.5 top-2.5 text-[0.75rem] text-brand-yellow font-bold">®</span>
                </div>
                <span class="font-tech text-[0.75rem] font-bold text-zinc-500 lowercase -mt-3 ml-1.5 text-center w-full" style="letter-spacing: 0.53em;">tecnologia</span>
            </div>
        </div>

        <div class="text-zinc-500 text-xs md:text-sm leading-relaxed space-y-1 mb-8 opacity-60">
            <p><strong>Cel.Lep Idiomas (A/C Kauã - Compras)</strong> | Rua Pedro de Toledo, 200 - Vila Mariana, São Paulo - SP</p>
            <p>Proposta Técnica Comercial #CELLEP-2026 | Emitida em 2026</p>
        </div>

        <div class="inline-flex items-center justify-center gap-2 border border-zinc-800 bg-zinc-900/50 px-5 py-2.5 rounded-full mb-6 shadow-sm">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-brand-yellow"></i>
            <span class="text-[10px] md:text-xs text-zinc-400 uppercase tracking-widest font-bold">Documento confidencial corporativo</span>
        </div>
        
        <p class="text-[10px] text-zinc-700 uppercase tracking-widest font-bold mt-6">Engenharia de Segurança &amp; Controle de Acesso Corporativo</p>
    </div>
</footer>

<!-- ===================== JAVASCRIPT LOGIC ===================== -->
<script>
    // DADOS FINANCEIROS EXATOS (COM ASSINATURA UNIFICADA + VISION CARE R$ 150/mês)
    const pricing = {
        opt1: {
            title: "Portão Facial Cel.Lep (Sem TVIP)",
            desc: "Automação de alto fluxo para o portão de pedestres/vidro com biometria facial, fechamento suave e nobreak.",
            badge: "⭐ Escopo Essencial: Facial + Automação",
            pix: 4890.00,
            pixHalf: 2445.00,
            cardTotal: 5870.00,
            cardMonthly: 489.17,
            combo36: 355.28, // Unificado: 205.28 + 150.00
            combo48: 325.41, // Unificado: 175.41 + 150.00
            items: [
                "<strong>01x Leitor Facial Intelbras SS 3532 MF:</strong> Reconhecimento biométrico ultrarrápido (&lt;0.5s) com câmera dupla anti-fake.",
                "<strong>01x Fechadura Eletroímã 150 kgf</strong> com sensor integrado + <strong>01x Mola Aérea Hidráulica MH 104</strong> (fechamento suave sem impacto no vidro).",
                "<strong>01x Botoeira de Saída Inox No Touch</strong> (abertura sem toque) + <strong>01x Fonte Nobreak com Bateria VRLA</strong> (continuidade em queda de luz).",
                "<strong>Infraestrutura Completa Zincada:</strong> 15 eletrodutos 3/4, 10 conduletes cega, 40 tampões, 30 abraçadeiras, 5 curvas e 50m cabo de rede.",
                "<strong>Mão de Obra Especializada Vision:</strong> Fixações mecânicas, conectorização, configurações lógicas e garantia de 12 meses."
            ]
        },
        opt2: {
            title: "Portão Facial + Monitor IP TVIP (Com Vídeo)",
            desc: "Solução completa: biometria facial no portão + Terminal de Vídeo IP TVIP 2221 HF dedicado na mesa da recepção.",
            badge: "🚀 Escopo Completo: Facial + Recepção de Vídeo IP",
            pix: 6570.00,
            pixHalf: 3285.00,
            cardTotal: 7880.00,
            cardMonthly: 656.66,
            combo36: 425.80, // Unificado: 275.80 + 150.00
            combo48: 385.68, // Unificado: 235.68 + 150.00
            items: [
                "<strong>01x Leitor Facial Intelbras SS 3532 MF</strong> com protocolo IP e câmera integrada no portão.",
                "<strong>01x Terminal de Vídeo IP Intelbras TVIP 2221 HF:</strong> Tela touch de recepção para atender visitantes em vídeo e abrir o portão.",
                "<strong>01x Fechadura Eletroímã 150 kgf</strong> + <strong>01x Mola Aérea Hidráulica MH 104</strong> (proteção total contra impacto no vidro).",
                "<strong>01x Botoeira de Saída Inox No Touch</strong> + <strong>01x Fonte Nobreak com Bateria VRLA</strong> de backup ininterrupto.",
                "<strong>Infraestrutura Completa Zincada:</strong> 15 eletrodutos 3/4, 10 conduletes cega, 40 tampões, 30 abraçadeiras, 5 curvas e 50m cabo de rede.",
                "<strong>Mão de Obra Especializada Vision:</strong> Instalação mecânica, cabeamento estruturado entre portão e recepção + 12 meses garantia."
            ]
        }
    };

    let selectedScope = 1; // 1 = Sem TVIP, 2 = Com TVIP
    let selectedPayment = 'pix'; // 'pix', 'card', 'loc'
    let selectedLocTerm = 36; // 36 ou 48 meses

    function formatBRL(val) {
        return val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function selectScope(scopeNum) {
        selectedScope = scopeNum;
        const btn1 = document.getElementById('btn-opt1');
        const btn2 = document.getElementById('btn-opt2');

        if (scopeNum === 1) {
            btn1.className = "w-1/2 py-3 rounded-xl text-xs md:text-sm font-bold bg-white text-gray-900 shadow-sm transition-all flex items-center justify-center gap-1.5";
            btn2.className = "w-1/2 py-3 rounded-xl text-xs md:text-sm font-bold bg-transparent text-gray-500 hover:text-gray-900 transition-all flex items-center justify-center gap-1.5";
        } else {
            btn2.className = "w-1/2 py-3 rounded-xl text-xs md:text-sm font-bold bg-white text-gray-900 shadow-sm transition-all flex items-center justify-center gap-1.5";
            btn1.className = "w-1/2 py-3 rounded-xl text-xs md:text-sm font-bold bg-transparent text-gray-500 hover:text-gray-900 transition-all flex items-center justify-center gap-1.5";
        }

        renderScopeDetails();
        renderPriceDisplay();
        if (window.clarity) window.clarity("event", "Mudou_Escopo_Opcao_" + scopeNum);
    }

    function setLocTerm(term) {
        selectedLocTerm = term;
        renderPriceDisplay();
        if (window.clarity) window.clarity("event", "Mudou_Prazo_Locacao_" + term);
    }

    function selectPayment(paymentMode) {
        selectedPayment = paymentMode;
        const btnPix = document.getElementById('btn-pay-pix');
        const btnCard = document.getElementById('btn-pay-card');
        const btnLoc = document.getElementById('btn-pay-loc');

        [btnPix, btnCard, btnLoc].forEach(b => {
            if (b) b.className = "px-5 py-2 rounded-full text-xs font-bold bg-transparent text-gray-500 hover:text-gray-800 transition-all";
        });

        const careBox = document.getElementById('vision-care-box');
        const careDesc = document.getElementById('vision-care-desc');
        const labelMode = document.getElementById('label-pricing-mode');

        if (paymentMode === 'pix') {
            btnPix.className = "px-5 py-2 rounded-full text-xs font-bold bg-brand-yellow text-black shadow-md transition-all";
            if (labelMode) labelMode.textContent = "Investimento no PIX";
            if (careBox) {
                careBox.className = "p-3.5 bg-amber-50/70 rounded-2xl border border-amber-200/70 text-xs text-amber-900 flex items-start gap-2.5 transition-all";
            }
            if (careDesc) {
                careDesc.innerHTML = "Visitas preventivas semestrais + suporte prioritário por R$ 150,00/mês como opcional de contratação.";
            }
        } else if (paymentMode === 'card') {
            btnCard.className = "px-5 py-2 rounded-full text-xs font-bold bg-brand-yellow text-black shadow-md transition-all";
            if (labelMode) labelMode.textContent = "Investimento Parcelado no Cartão";
            if (careBox) {
                careBox.className = "p-3.5 bg-amber-50/70 rounded-2xl border border-amber-200/70 text-xs text-amber-900 flex items-start gap-2.5 transition-all";
            }
            if (careDesc) {
                careDesc.innerHTML = "Visitas preventivas semestrais + suporte prioritário por R$ 150,00/mês como opcional de contratação.";
            }
        } else {
            btnLoc.className = "px-5 py-2 rounded-full text-xs font-bold bg-brand-yellow text-black shadow-md transition-all flex items-center gap-1.5";
            if (labelMode) labelMode.textContent = "Assinatura All-Inclusive (Tudo Incluso)";
            if (careBox) {
                careBox.className = "p-3.5 bg-emerald-50 rounded-2xl border border-emerald-200 text-xs text-emerald-950 flex items-start gap-2.5 transition-all shadow-xs";
            }
            if (careDesc) {
                careDesc.innerHTML = "<strong>Plano de Manutenção e Suporte Vision Care já 100% incluso na mensalidade!</strong> Suporte prioritário, visitas semestrais e substituição de equipamentos com cobertura contínua durante todo o contrato.";
            }
        }

        renderPriceDisplay();
        if (window.clarity) window.clarity("event", "Mudou_Pagamento_" + paymentMode);
    }

    function renderScopeDetails() {
        const data = selectedScope === 1 ? pricing.opt1 : pricing.opt2;
        const badgeEl = document.getElementById('badge-scope');
        const titleEl = document.getElementById('title-scope');
        const descEl = document.getElementById('desc-scope');
        const ul = document.getElementById('scope-items');

        if (badgeEl) badgeEl.innerHTML = data.badge;
        if (titleEl) titleEl.textContent = data.title;
        if (descEl) descEl.textContent = data.desc;

        if (ul) {
            ul.innerHTML = data.items.map(item => `
                <li class="flex items-start gap-2.5 text-xs md:text-sm text-gray-700">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-brand-yellow shrink-0 mt-0.5"></i>
                    <span>${item}</span>
                </li>
            `).join('');
        }

        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }

    function renderPriceDisplay() {
        const data = selectedScope === 1 ? pricing.opt1 : pricing.opt2;
        const box = document.getElementById('price-display-box');
        const ctaBtn = document.getElementById('btn-whatsapp-cta');
        const ctaText = document.getElementById('cta-btn-text');

        if (!box) return;

        let html = '';
        let whatsappMsg = '';

        if (selectedPayment === 'pix') {
            html = `
                <div class="flex flex-col items-center justify-center w-full animate-fade-in">
                    <div class="flex items-baseline justify-center gap-1.5 mb-2">
                        <span class="text-2xl font-bold text-gray-400">R$</span>
                        <span class="text-5xl md:text-6xl font-extrabold text-[#111827] tracking-tighter leading-none">${formatBRL(data.pix).split(',')[0]}<span class="text-3xl text-gray-400">,${formatBRL(data.pix).split(',')[1]}</span></span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 text-emerald-700 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest mt-2">
                        <i data-lucide="zap" class="w-3 h-3"></i> Pagamento à vista (PIX)
                    </div>
                    
                    <div class="w-full mt-6 space-y-2 text-left">
                        <div class="bg-white border border-gray-200 rounded-xl p-3 shadow-xs relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-1.5 h-full bg-emerald-400"></div>
                            <div class="pl-2">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-gray-500 block">Sinal (Aprovação e Início na Obra)</span>
                                <span class="font-bold text-gray-900 text-sm">R$ ${formatBRL(data.pixHalf)}</span>
                            </div>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-xl p-3 shadow-xs relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-1.5 h-full bg-brand-yellow"></div>
                            <div class="pl-2">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-gray-500 block">Finalização (Entrega &amp; Testes Operacionais)</span>
                                <span class="font-bold text-gray-900 text-sm">R$ ${formatBRL(data.pixHalf)}</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            whatsappMsg = `Fala Gabriel! Analisei a proposta do portão da nova unidade do Cel.Lep na Rua Pedro de Toledo. Como estamos em plena reforma por aqui, gostaríamos de aprovar a *${data.title}* no valor de *R$ ${formatBRL(data.pix)} no PIX* para já rodar a infraestrutura e o cabeamento junto com a obra esta semana. Como podemos formalizar?`;
            if (ctaText) ctaText.textContent = `Aprovar ${selectedScope === 1 ? 'Opção 1' : 'Opção 2'} (PIX)`;

        } else if (selectedPayment === 'card') {
            html = `
                <div class="flex flex-col items-center justify-center w-full animate-fade-in">
                    <span class="text-xs font-bold text-gray-400 mb-1">Parcelamento Facilitado</span>
                    <div class="flex items-baseline justify-center gap-1.5 mb-3">
                        <span class="text-2xl font-bold text-[#111827]">12x de R$</span>
                        <span class="text-5xl md:text-6xl font-extrabold text-[#111827] tracking-tighter leading-none">${formatBRL(data.cardMonthly).split(',')[0]}<span class="text-3xl text-gray-400">,${formatBRL(data.cardMonthly).split(',')[1]}</span></span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 bg-blue-50 border border-blue-200 text-blue-700 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest mt-1">
                        <i data-lucide="credit-card" class="w-3 h-3"></i> Cartão de Crédito Corporativo
                    </div>
                    <p class="text-xs text-gray-500 font-medium mt-4">Valor total no cartão: R$ ${formatBRL(data.cardTotal)}</p>
                </div>
            `;
            whatsappMsg = `Fala Gabriel! Analisei a proposta do portão do Cel.Lep Vila Mariana e gostaríamos de aprovar a *${data.title}* em *12x de R$ ${formatBRL(data.cardMonthly)} no cartão* para aproveitar a fase de reforma do imóvel esta semana.`;
            if (ctaText) ctaText.textContent = `Aprovar ${selectedScope === 1 ? 'Opção 1' : 'Opção 2'} (12x Cartão)`;

        } else {
            const is36 = selectedLocTerm === 36;
            const currentCombo = is36 ? data.combo36 : data.combo48;

            html = `
                <div class="flex flex-col items-center justify-center w-full animate-fade-in">
                    
                    <!-- Alternador de prazo 36 vs 48 -->
                    <div class="inline-flex bg-gray-200/80 p-1 rounded-xl mb-3 border border-gray-300/50">
                        <button type="button" onclick="setLocTerm(36)" class="px-3 py-1 rounded-lg text-[11px] font-bold transition-all ${is36 ? 'bg-zinc-900 text-white shadow-sm' : 'text-gray-600 hover:text-gray-900'}">
                            Plano 36 Meses
                        </button>
                        <button type="button" onclick="setLocTerm(48)" class="px-3 py-1 rounded-lg text-[11px] font-bold transition-all ${!is36 ? 'bg-zinc-900 text-white shadow-sm' : 'text-gray-600 hover:text-gray-900'}">
                            Plano 48 Meses
                        </button>
                    </div>

                    <div class="flex items-baseline justify-center gap-1.5 mb-2">
                        <span class="text-2xl font-bold text-gray-500">R$</span>
                        <span class="text-5xl md:text-6xl font-extrabold text-[#111827] tracking-tighter leading-none">${formatBRL(currentCombo).split(',')[0]}<span class="text-3xl text-gray-400">,${formatBRL(currentCombo).split(',')[1]}</span></span>
                        <span class="text-xs font-bold text-gray-500">/mês</span>
                    </div>

                    <div class="inline-flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 text-emerald-800 px-3.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest mt-1 shadow-xs">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-600"></i> Assinatura Completa All-Inclusive
                    </div>
                    
                    <!-- Bloco Único: O que está incluso (Sem desmembrar valores) -->
                    <div class="mt-5 p-4 bg-white rounded-2xl border border-gray-200 w-full text-xs text-left shadow-xs space-y-2.5">
                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-gray-400 block pb-1 border-b border-gray-100">O que está 100% incluso na mensalidade:</span>
                        <div class="flex items-start gap-2 text-gray-700">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5"></i>
                            <span><strong>Locação de Todo o Hardware:</strong> leitor facial, travas, infraestrutura zincada e periféricos.</span>
                        </div>
                        <div class="flex items-start gap-2 text-gray-700">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5"></i>
                            <span><strong>Instalação &amp; Configuração na Obra:</strong> mão de obra especializada sem taxa inicial de implantação.</span>
                        </div>
                        <div class="flex items-start gap-2 text-gray-700">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5"></i>
                            <span><strong>Plano Vision Care Essential:</strong> suporte prioritário, chamados corretivos e visitas preventivas semestrais.</span>
                        </div>
                        <div class="flex items-start gap-2 text-gray-700">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5"></i>
                            <span><strong>Garantia Contínua &amp; Troca de Peças:</strong> cobertura integral contra falhas durante toda a vigência do contrato.</span>
                        </div>
                    </div>

                    <div class="mt-3 flex items-center justify-center gap-2 text-[10px] text-gray-500">
                        <i data-lucide="badge-percent" class="w-3.5 h-3.5 text-brand-yellow"></i>
                        <span>Zero taxa de implantação · Mensalidade dedutível como OPEX</span>
                    </div>
                </div>
            `;

            whatsappMsg = `Fala Gabriel! Vimos a proposta do Cel.Lep (Pedro de Toledo) e decidimos seguir no modelo de *Assinatura Unificada (Hardware + Vision Care)* para a *${data.title}* em *${selectedLocTerm} meses (R$ ${formatBRL(currentCombo)}/mês)*, aproveitando que o prédio está em reforma para já rodar a infraestrutura esta semana.`;
            if (ctaText) ctaText.textContent = `Aprovar Assinatura (${selectedLocTerm}x R$ ${formatBRL(currentCombo)})`;
        }

        box.innerHTML = html;
        if (ctaBtn) ctaBtn.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(whatsappMsg);
        
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }

    // ACCORDION TOGGLE
    function toggleAccordion(button) {
        const item = button.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }

    // CONTROLE DE ACESSO (LOCK SCREEN)
    function checkPassword() {
        const inputEl = document.getElementById('password-input');
        if (!inputEl) return;

        const input = inputEl.value.trim().toUpperCase();
        const errorMsg = document.getElementById('error-msg');
        const btnUnlock = document.getElementById('btn-unlock');
        const unlockIcon = document.getElementById('unlock-icon');
        const unlockText = document.getElementById('unlock-text');
        const unlockArrow = document.getElementById('unlock-arrow');

        const validPasswords = ['KAUA2026', 'CELLEP2026', 'CELLEP', 'KAUA', 'VISION'];

        if (validPasswords.includes(input)) {
            if (btnUnlock) btnUnlock.disabled = true;
            if (unlockText) unlockText.textContent = "Validando Acesso...";
            if (unlockIcon) unlockIcon.className = "w-5 h-5 animate-spin text-black";
            if (unlockArrow) unlockArrow.style.display = 'none';

            setTimeout(() => {
                const lockScreen = document.getElementById('lock-screen');
                if (lockScreen) lockScreen.style.opacity = '0';

                const video = document.getElementById("vision-video");
                if (video && video.paused) {
                    video.muted = true;
                    video.play().catch(() => {});
                }

                if (window.clarity) {
                    try {
                        window.clarity("consent");
                        window.clarity("identify", "kaua-cellep", undefined, undefined, "Kauã (Cel.Lep Vila Mariana)");
                        window.clarity("set", "Proposta", "Projeto_Acesso_CelLep");
                        window.clarity("event", "Proposta_Desbloqueada");
                    } catch(e) {}
                }

                // Log silencioso de abertura
                fetch('https://api.staticforms.dev/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        accessKey: "sf_077ej49gjha153gk3m6ceecf",
                        subject: "🚨 ALERTA: Proposta Acessada (Kauã - Cel.Lep Vila Mariana)",
                        name: "Sistema Vision",
                        email: "diretoria@visionsp.com.br",
                        message: "O cliente Kauã (Cel.Lep) acessou a proposta do portão da Vila Mariana!\n\n🔑 Senha Utilizada: " + input + "\n🕒 Horário: " + new Date().toLocaleString('pt-BR')
                    })
                }).catch(() => {});

                setTimeout(() => {
                    if (lockScreen) lockScreen.style.display = 'none';
                    const htmlRoot = document.getElementById('html-root');
                    if (htmlRoot) {
                        htmlRoot.classList.remove('overflow-hidden', 'h-screen');
                        htmlRoot.classList.add('overflow-x-hidden');
                    }
                    document.body.classList.remove('overflow-hidden', 'h-screen');
                }, 700);

            }, 600);

        } else {
            if (errorMsg) errorMsg.classList.remove('hidden');
            inputEl.style.borderColor = 'rgba(239,68,68,0.5)';
            setTimeout(() => {
                if (errorMsg) errorMsg.classList.add('hidden');
                inputEl.style.borderColor = '';
            }, 3000);
        }
    }

    // EVENT LISTENERS & INICIALIZAÇÃO
    document.addEventListener("DOMContentLoaded", function() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }

        const pwdInput = document.getElementById('password-input');
        if (pwdInput) {
            pwdInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });
        }

        // Observador de elementos com reveal
        try {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('active');
                });
            }, { threshold: 0.08 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        } catch(e) {
            document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
        }

        // Vídeo e Unmute
        const videoHero = document.getElementById("vision-video");
        const overlayHero = document.getElementById("unmute-overlay");

        if (videoHero && overlayHero) {
            overlayHero.addEventListener("click", function(e) {
                e.stopPropagation();
                videoHero.muted = false;
                videoHero.loop = true;
                videoHero.currentTime = 0;
                videoHero.play().catch(() => {});
                overlayHero.style.opacity = "0";
                setTimeout(() => { overlayHero.style.display = "none"; }, 400);

                if (window.clarity) {
                    try { window.clarity("event", "Video_Assistido_CelLep"); } catch(err) {}
                }
            });

            videoHero.addEventListener("click", function() {
                if (overlayHero.style.display === "none") {
                    if (videoHero.paused) { videoHero.play(); } else { videoHero.pause(); }
                }
            });
        }

        // Renderização inicial
        renderScopeDetails();
        renderPriceDisplay();

        // Pausa no Carrossel de Avaliações com Touch no Celular
        const reviewsTrack = document.getElementById('reviews-track');
        const reviewsContainer = document.getElementById('reviews-container');
        if (reviewsTrack && reviewsContainer) {
            reviewsContainer.addEventListener('touchstart', function() {
                reviewsTrack.classList.add('paused');
            }, { passive: true });

            reviewsContainer.addEventListener('touchend', function() {
                reviewsTrack.classList.remove('paused');
            }, { passive: true });

            reviewsContainer.addEventListener('touchcancel', function() {
                reviewsTrack.classList.remove('paused');
            }, { passive: true });
        }
    });

    // Navbar Scroll Shadow
    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        if (navbar) {
            if (window.scrollY > 40) {
                navbar.classList.add('shadow-md');
            } else {
                navbar.classList.remove('shadow-md');
            }
        }
    });
</script>
</body>
</html>
