    // CONTROLE DOS VÍDEOS INTERATIVOS (PREVIEW MUDO -> PLAY COM ÁUDIO -> PAUSA AO FINALIZAR)
    function playFullVideo(videoId, overlayId, textId) {
        const video = document.getElementById(videoId);
        const overlay = document.getElementById(overlayId);
        const textLabel = textId ? document.getElementById(textId) : null;
        if (!video || !overlay) return;

        // Pausa qualquer outro vídeo que esteja com áudio para não sobrepor
        document.querySelectorAll('video').forEach(v => {
            if (v.id !== videoId && !v.muted) {
                v.muted = true;
                v.loop = true;
                v.play();
                const otherOverlay = document.getElementById('overlay-' + v.id.replace('video-', ''));
                if (otherOverlay) otherOverlay.classList.remove('opacity-0', 'pointer-events-none');
            }
        });

        // Configura para reprodução real
        video.loop = false;
        video.muted = false;
        video.currentTime = 0;
        video.controls = true;

        video.play().then(() => {
            overlay.classList.add('opacity-0', 'pointer-events-none');
        }).catch(err => {
            console.log('Autoplay com som requer interação:', err);
            video.muted = false;
            video.play();
            overlay.classList.add('opacity-0', 'pointer-events-none');
        });

        // Quando o vídeo finaliza, pausa e reexibe o botão para assistir de novo
        video.onended = function() {
            video.pause();
            video.controls = false;
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            if (textLabel) {
                textLabel.textContent = "Reproduzir Novamente";
            }
        };
    }

