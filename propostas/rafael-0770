            setTimeout(() => {
                if (errorMsg) errorMsg.classList.add('hidden');
                inputEl.style.borderColor = '';
            }, 3000);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const pwdInput = document.getElementById('password-input');
        if (pwdInput) {
            pwdInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });
        }
    });

    function toggleAccordion(button) {
        const item = button.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
    }

    // DADOS FINANCEIROS VISION (R$ 14.879 NO PIX)
    const pricingData = {
        pixExact: 14879,
        cardTotal: 17854,
        installment12: 1488
    };

    let currentPaymentMode = 'avista';

    function formatExactCurrency(val) {
        return val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatIntegerCurrency(val) {
        return Math.round(val).toLocaleString('pt-BR');
    }

    function setPaymentMode(mode) {
        currentPaymentMode = mode;
        const bg = document.getElementById('toggle-bg');
        const btnPix = document.getElementById('btn-avista');
        const btnParcelado = document.getElementById('btn-parcelado');
        const selectContainer = document.getElementById('installment-container');

        if (mode === 'avista') {
            if (bg) bg.style.transform = 'translateX(0)';
            if (btnPix) {
                btnPix.classList.remove('text-gray-500');
                btnPix.classList.add('text-gray-900');
            }
            if (btnParcelado) {
                btnParcelado.classList.remove('text-gray-900');
                btnParcelado.classList.add('text-gray-500');
            }
            if (selectContainer) {
                selectContainer.classList.add('opacity-0', 'pointer-events-none');
                setTimeout(() => { if(selectContainer) selectContainer.classList.add('hidden'); }, 300);
            }
        } else {
            if (bg) bg.style.transform = 'translateX(100%)';
            if (btnParcelado) {
                btnParcelado.classList.remove('text-gray-500');
                btnParcelado.classList.add('text-gray-900');
            }
            if (btnPix) {
                btnPix.classList.remove('text-gray-900');
                btnPix.classList.add('text-gray-500');
            }
            if (selectContainer) {
                selectContainer.classList.remove('hidden');
                setTimeout(() => { if(selectContainer) selectContainer.classList.remove('opacity-0', 'pointer-events-none'); }, 10);
            }
        }

        updatePrices();
    }

    function updateWhatsAppLink() {
        const btnLink = document.getElementById('btn-aprova-link');
        if (!btnLink) return;

        let message = '';

        if (currentPaymentMode === 'avista') {
            message = `Olá Gabriel, analisei a proposta do galpão na Rua Aroaba (16 câmeras IP Full Color com áudio, Central 16 canais com HD 2TB, Nobreak inteligente, rack no escritório superior, infraestrutura e instalação) e gostaríamos de aprovar a execução à Vista de R$ ${formatIntegerCurrency(pricingData.pixExact)} via PIX com 50% de sinal e 50% na conclusão.`;
        } else {
            const select = document.getElementById('installment-select');
            const installments = select ? parseInt(select.value) : 12;
            
            let totalVal = pricingData.cardTotal;
            if (installments < 12) {
                const pixVal = pricingData.pixExact;
                const factor = 1 + ((1.1999 - 1) * (installments / 12));
                totalVal = Math.round(pixVal * factor);
            }
            const instVal = Math.round(totalVal / installments);

            message = `Olá Gabriel, analisei a proposta do galpão na Rua Aroaba (16 câmeras IP Full Color com áudio, Nobreak e Central 2TB) e gostaríamos de aprovar o projeto parcelado em ${installments}x de R$ ${formatIntegerCurrency(instVal)} no cartão da Verde Interior Paisagismo.`;
        }

        btnLink.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(message);
    }

    function updatePrices() {
        const priceContainer = document.getElementById('price-opt1');
        const select = document.getElementById('installment-select');
        if (!priceContainer) return;

        if (currentPaymentMode === 'avista') {
            priceContainer.innerHTML = `
                <div class="flex flex-col items-center w-full animate-fade-in">
                    <span class="text-[9px] text-[#8a6208] uppercase tracking-widest font-bold mb-1">Preço À Vista com Desconto PIX</span>
                    <span class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-4">R$ ${formatIntegerCurrency(pricingData.pixExact)}</span>
                    
                    <div class="w-full space-y-2">
                        <div class="bg-white border border-gray-200/90 rounded-xl py-2 px-3 flex items-center justify-between relative overflow-hidden shadow-xs">
                            <div class="absolute top-0 left-0 w-1.5 h-full bg-[#34d399] rounded-l-lg"></div>
                            <span class="text-[10px] font-bold text-gray-600 pl-1">Sinal de Entrada (50%)</span>
                            <span class="text-xs font-black text-gray-900">R$ ${formatExactCurrency(pricingData.pixExact / 2)}</span>
                        </div>
                        <div class="bg-white border border-gray-200/90 rounded-xl py-2 px-3 flex items-center justify-between relative overflow-hidden shadow-xs">
                            <div class="absolute top-0 left-0 w-1.5 h-full bg-[#c8a048] rounded-l-lg"></div>
                            <span class="text-[10px] font-bold text-gray-600 pl-1">Saldo na Entrega (50%)</span>
                            <span class="text-xs font-black text-gray-900">R$ ${formatExactCurrency(pricingData.pixExact / 2)}</span>
                        </div>
                    </div>
                </div>
            `;
        } else {
            const inst = parseInt(select ? select.value : '12');
            let totalVal = pricingData.cardTotal;
            if (inst < 12) {
                const pixVal = pricingData.pixExact;
                const factor = 1 + ((1.1999 - 1) * (inst / 12));
                totalVal = Math.round(pixVal * factor);
            }
            const instVal = Math.round(totalVal / inst);

            priceContainer.innerHTML = `
                <div class="flex flex-col items-center w-full animate-fade-in">
                    <div class="flex items-baseline justify-center gap-1.5 mb-1.5">
                        <span class="text-lg md:text-xl font-bold text-brand-yellow">${inst}x de R$</span> 
                        <span class="text-4xl md:text-5xl font-black text-gray-900">${formatIntegerCurrency(instVal)}</span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 bg-blue-50 border border-blue-200 text-blue-700 px-3 py-1 rounded-full w-fit shadow-xs mb-2">
                        <i data-lucide="credit-card" class="w-3.5 h-3.5"></i>
                        <span class="text-[10px] font-bold uppercase tracking-widest">Cartão de Crédito Corporativo</span>
                    </div>
                    <p class="text-[10px] text-gray-500 font-medium">Total Parcelado: R$ ${formatIntegerCurrency(totalVal)}</p>
                </div>
            `;
        }

        updateWhatsAppLink();
        initIcons();
    }

    window.addEventListener("load", () => {
        setPaymentMode('avista');
    });

    try {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    } catch(e) {
        document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
    }

    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        const ctaFloat = document.getElementById('cta-float');
        
        if (window.scrollY > 40) {
            if(navbar) navbar.classList.add('shadow-md');
        } else {
            if(navbar) navbar.classList.remove('shadow-md');
        }

        if (window.scrollY > 400) {
            if(ctaFloat) {
                ctaFloat.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
                ctaFloat.classList.add('opacity-100', 'translate-y-0');
            }
        } else {
            if(ctaFloat) {
                ctaFloat.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
                ctaFloat.classList.remove('opacity-100', 'translate-y-0');
            }
        }
    });
</script>
