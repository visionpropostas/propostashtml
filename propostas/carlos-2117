                    document.body.classList.remove('overflow-hidden', 'h-screen');
                }, 700);

            }, 800);

        } else {
            if (errorMsg) errorMsg.classList.remove('hidden');
            inputEl.style.borderColor = 'rgba(239,68,68,0.5)';
            setTimeout(() => {
                if (errorMsg) errorMsg.classList.add('hidden');
                inputEl.style.borderColor = '';
            }, 3000);
        }
    }

    // ENTER KEY ON PASSWORD INPUT
    document.addEventListener("DOMContentLoaded", () => {
        const pwdInput = document.getElementById('password-input');
        if (pwdInput) {
            pwdInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });
        }
    });

    // ACCORDION TOGGLE
    function toggleAccordion(button) {
        const item = button.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
    }

    // CÁLCULO FINANCEIRO EXATO OBRA 18 (R$ 200/PONTO À VISTA EM 841 PONTOS)
    // PIX Exact: R$ 168.200,00 (841 x R$ 200,00)
    // Cartão Total (12x): 168.200,00 * 1.1999 = R$ 201.823,18 -> R$ 201.820,00
    // Parcelas 12x: 201.820,00 / 12 = R$ 16.818,33
    const pricingData = {
        pixExact: 168200.00,
        cardTotal: 201820.00,
        installment12: 16818.33
    };

    let currentPaymentMode = 'avista'; // 'avista' vs 'parcelado'

    function formatExactCurrency(val) {
        return val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function setPaymentMode(mode) {
        currentPaymentMode = mode;
        const bg = document.getElementById('toggle-bg');
        const btnPix = document.getElementById('btn-avista');
        const btnParcelado = document.getElementById('btn-parcelado');
        const selectContainer = document.getElementById('installment-container');

        if (mode === 'avista') {
            if (bg) bg.style.transform = 'translateX(0)';
            if (btnPix) {
                btnPix.classList.remove('text-gray-500');
                btnPix.classList.add('text-gray-900');
            }
            if (btnParcelado) {
                btnParcelado.classList.remove('text-gray-900');
                btnParcelado.classList.add('text-gray-500');
            }
            if (selectContainer) {
                selectContainer.classList.add('opacity-0', 'pointer-events-none');
                setTimeout(() => { if(selectContainer) selectContainer.classList.add('hidden'); }, 300);
            }
        } else {
            if (bg) bg.style.transform = 'translateX(100%)';
            if (btnParcelado) {
                btnParcelado.classList.remove('text-gray-500');
                btnParcelado.classList.add('text-black');
            }
            if (btnPix) {
                btnPix.classList.remove('text-black');
                btnPix.classList.add('text-gray-500');
            }
            if (selectContainer) {
                selectContainer.classList.remove('hidden');
                setTimeout(() => { if(selectContainer) selectContainer.classList.remove('opacity-0', 'pointer-events-none'); }, 10);
            }
        }

        updatePrices();
    }

    function updateWhatsAppLink() {
        const btnLink = document.getElementById('btn-aprova-link');
        if (!btnLink) return;

        let message = '';

        if (currentPaymentMode === 'avista') {
            message = `Olá Gabriel, analisei a proposta da Obra 18 para a instalação das 841 fechaduras com insumo de espuma e gostaríamos de aprovar o projeto com pagamento à Vista de R$ ${formatExactCurrency(pricingData.pixExact)} via PIX.`;
        } else {
            const select = document.getElementById('installment-select');
            const installments = select ? parseInt(select.value) : 12;
            
            let totalVal = pricingData.cardTotal;
            if (installments < 12) {
                const pixVal = pricingData.pixExact;
                const factor = 1 + ((1.1999 - 1) * (installments / 12));
                totalVal = pixVal * factor;
            }
            const instVal = totalVal / installments;

            message = `Olá Gabriel, analisei a proposta da Obra 18 para a instalação das 841 fechaduras com insumo de espuma e gostaríamos de aprovar o projeto parcelado em ${installments}x de R$ ${formatExactCurrency(instVal)} no cartão de crédito.`;
        }

        btnLink.href = "https://wa.me/5511930816696?text=" + encodeURIComponent(message);
    }

    function updatePrices() {
        const priceContainer = document.getElementById('price-opt1');
        const select = document.getElementById('installment-select');
        if (!priceContainer) return;

        if (currentPaymentMode === 'avista') {
            priceContainer.innerHTML = `
                <div class="flex flex-col items-center w-full animate-fade-in font-sans">
                    <p class="text-[8px] md:text-[10px] text-[#8a6208] uppercase tracking-widest font-bold mb-1">À Vista no PIX (R$ 200,00 por Ponto)</p>
                    <span class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-4">R$ ${formatExactCurrency(pricingData.pixExact)}</span>
                    
                    <div class="w-full space-y-2">
                        <div class="bg-white border border-gray-200 rounded-xl py-2.5 flex flex-col items-center justify-center relative overflow-hidden shadow-xs">
                            <div class="absolute top-0 left-0 w-1 h-full bg-[#34d399] rounded-l-lg"></div>
                            <span class="text-[8px] font-bold uppercase tracking-widest text-brand-goldDark mb-0.5 font-sans">Sinal de Mobilização e Insumos (50%)</span>
                            <span class="text-sm font-bold text-gray-900">R$ ${formatExactCurrency(pricingData.pixExact / 2)}</span>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-xl py-2.5 flex flex-col items-center justify-center relative overflow-hidden shadow-xs">
                            <div class="absolute top-0 left-0 w-1.5 h-full bg-[#c8a048] rounded-l-lg"></div>
                            <span class="text-[8px] font-bold uppercase tracking-widest text-brand-goldDark mb-0.5 font-sans">Saldo na Conclusão da Instalação (50%)</span>
                            <span class="text-sm font-bold text-gray-900">R$ ${formatExactCurrency(pricingData.pixExact / 2)}</span>
                        </div>
                    </div>
                </div>
            `;
        } else {
            const inst = parseInt(select ? select.value : '12');
            let totalVal = pricingData.cardTotal;
            if (inst < 12) {
                const pixVal = pricingData.pixExact;
                const factor = 1 + ((1.1999 - 1) * (inst / 12));
                totalVal = pixVal * factor;
            }
            const instVal = totalVal / inst;

            priceContainer.innerHTML = `
                <div class="flex flex-col items-center w-full mt-2 mb-2 animate-fade-in font-sans">
                    <div class="flex items-baseline justify-center gap-1.5 mb-2">
                        <span class="text-xl md:text-2xl font-bold text-brand-yellow">${inst}x de R$</span> 
                        <span class="text-4xl md:text-5xl font-black text-gray-900">${formatExactCurrency(instVal)}</span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 bg-blue-50 border border-blue-200 text-blue-700 px-3 py-1 rounded-full w-fit shadow-xs mt-2 mb-3 font-sans">
                        <i data-lucide="credit-card" class="w-4 h-4"></i>
                        <span class="text-[10px] md:text-[11px] font-bold uppercase tracking-widest">Cartão Corporativo / Faturamento</span>
                    </div>
                    <p class="text-[10px] text-gray-500 font-medium font-sans">Total Parcelado: R$ ${formatExactCurrency(totalVal)}</p>
                </div>
            `;
        }

        updateWhatsAppLink();
        initIcons();
    }

    // INITIAL LOAD
    window.addEventListener("load", () => {
        setPaymentMode('avista');
    });

    // INTERSECTION OBSERVER REVEAL
    try {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    } catch(e) {
        document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
    }

    // SCROLL LISTENERS
    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        const ctaFloat = document.getElementById('cta-float');
        
        if (window.scrollY > 50) {
            if(navbar) navbar.classList.add('shadow-md');
        } else {
            if(navbar) navbar.classList.remove('shadow-md');
        }

        if (window.scrollY > 400) {
            if(ctaFloat) {
                ctaFloat.classList.remove('hidden', 'opacity-0', 'translate-y-10', 'pointer-events-none');
                ctaFloat.classList.add('opacity-100', 'translate-y-0');
            }
        } else {
            if(ctaFloat) {
                ctaFloat.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }
        }
    });
</script>
</body>
</html>
