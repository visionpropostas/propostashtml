    // Formata valores monetários no padrão brasileiro
    function formatExactCurrency(val) {
        return val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Posiciona a pílula deslizante no seletor de modo de pagamento
    function positionTogglePill(activeBtn) {
        const bg = document.getElementById('toggle-bg');
        if (!bg || !activeBtn) return;
        if (activeBtn.offsetWidth > 0) {
            bg.style.left = `${activeBtn.offsetLeft}px`;
            bg.style.width = `${activeBtn.offsetWidth}px`;
        }
    }

    // Seleciona a opção (Intelbras, Control iD ou Biometria iDFlex) e atualiza os valores
    function setBrand(brand) {
        currentBrand = brand;
        const btnIntelbras = document.getElementById('brand-intelbras');
        const btnControlId = document.getElementById('brand-controlid');
        const btnBiometria = document.getElementById('brand-biometria');
        const cardBadge = document.getElementById('card-badge');
        const controllerDesc = document.getElementById('item-controller-desc');
        const subSelect = document.getElementById('subscription-select');

        const activeClass = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-zinc-900 text-white shadow-sm font-sans';
        const inactiveClass = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-gray-600 hover:text-gray-900 font-sans';

        if (btnIntelbras) btnIntelbras.className = brand === 'intelbras' ? activeClass : inactiveClass;
        if (btnControlId) btnControlId.className = brand === 'controlid' ? activeClass : inactiveClass;
        if (btnBiometria) btnBiometria.className = brand === 'biometria' ? activeClass : inactiveClass;

        const data = brandPricing[brand] || brandPricing.intelbras;
        if (cardBadge) cardBadge.textContent = data.badge;
        if (controllerDesc) controllerDesc.innerHTML = data.controllerDesc;

        if (subSelect) {
            Array.from(subSelect.options).forEach(opt => {
                const m = opt.value;
                opt.textContent = `${m} meses (R$ ${formatExactCurrency(data.subscriptions[m])} / mês)`;
            });
        }

        updatePrices();
    }

    // Seleciona a forma de pagamento (PIX, Cartão ou Assinatura)
    function setPaymentMode(mode) {
        currentPaymentMode = mode;
        const btnPix = document.getElementById('btn-avista');
        const btnParcelado = document.getElementById('btn-parcelado');
        const btnAssinatura = document.getElementById('btn-assinatura');
        const selectContainer = document.getElementById('installment-container');
        const subContainer = document.getElementById('subscription-container');

        [btnPix, btnParcelado, btnAssinatura].forEach(btn => {
            if (btn) {
                btn.classList.remove('text-gray-900', 'text-black');
                btn.classList.add('text-gray-500');
            }
        });

        let activeBtn = btnPix;

        if (mode === 'avista') {
            activeBtn = btnPix;
            if (selectContainer) selectContainer.classList.add('opacity-0', 'pointer-events-none', 'hidden');
            if (subContainer) subContainer.classList.add('opacity-0', 'pointer-events-none', 'hidden');
        } else if (mode === 'parcelado') {
            activeBtn = btnParcelado;
            if (subContainer) subContainer.classList.add('opacity-0', 'pointer-events-none', 'hidden');
            if (selectContainer) {
                selectContainer.classList.remove('hidden');
                requestAnimationFrame(() => {
                    selectContainer.classList.remove('opacity-0', 'pointer-events-none');
                });
            }
        } else if (mode === 'assinatura') {
            activeBtn = btnAssinatura;
            if (selectContainer) selectContainer.classList.add('opacity-0', 'pointer-events-none', 'hidden');
            if (subContainer) {
                subContainer.classList.remove('hidden');
                requestAnimationFrame(() => {
                    subContainer.classList.remove('opacity-0', 'pointer-events-none');
                });
            }
        }

        if (activeBtn) {
            activeBtn.classList.remove('text-gray-500');
            activeBtn.classList.add('text-gray-900');
            positionTogglePill(activeBtn);
        }

        updatePrices();
    }

