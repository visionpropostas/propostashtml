    }

    function switchOption(opt) {
        if (currentOption === opt) return;
        currentOption = opt;

        const btn1 = document.getElementById('btn-opt1');
        const btn2 = document.getElementById('btn-opt2');

        if (opt === 1) {
            btn1.classList.add('bg-brand-yellow', 'text-black', 'shadow-md');
            btn1.classList.remove('bg-transparent', 'text-gray-500');
            btn2.classList.remove('bg-brand-yellow', 'text-black', 'shadow-md');
            btn2.classList.add('bg-transparent', 'text-gray-500');
        } else {
            btn2.classList.add('bg-brand-yellow', 'text-black', 'shadow-md');
            btn2.classList.remove('bg-transparent', 'text-gray-500');
            btn1.classList.remove('bg-brand-yellow', 'text-black', 'shadow-md');
            btn1.classList.add('bg-transparent', 'text-gray-500');
        }

        renderPricing();
        if (window.clarity) window.clarity("event", `Selecionou_Opcao_${opt}`);
    }

    function togglePayment(toPix) {
        if (isPix === toPix) return;
        isPix = toPix;

        const btnPix = document.getElementById('btn-pix');
        const btnCard = document.getElementById('btn-card');
        const pixBlock = document.getElementById('price-pix-block');
        const cardBlock = document.getElementById('price-card-block');

        if(pixBlock) pixBlock.classList.add('opacity-0');
        if(cardBlock) cardBlock.classList.add('opacity-0');

        setTimeout(() => {
            if (isPix) {
                btnPix.classList.add('bg-brand-yellow', 'text-black');
                btnPix.classList.remove('bg-transparent', 'text-gray-500');
                btnCard.classList.remove('bg-brand-yellow', 'text-black');
                btnCard.classList.add('bg-transparent', 'text-gray-500');

                pixBlock.classList.remove('hidden');
                cardBlock.classList.add('hidden');
                setTimeout(() => pixBlock.classList.remove('opacity-0'), 20);
            } else {
                btnCard.classList.add('bg-brand-yellow', 'text-black');
                btnCard.classList.remove('bg-transparent', 'text-gray-500');
                btnPix.classList.remove('bg-brand-yellow', 'text-black');
                btnPix.classList.add('bg-transparent', 'text-gray-500');

                pixBlock.classList.add('hidden');
                cardBlock.classList.remove('hidden');
                cardBlock.classList.add('flex');
                setTimeout(() => cardBlock.classList.remove('opacity-0'), 20);
            }
            lucide.createIcons();
        }, 200);

        if (window.clarity) window.clarity("event", isPix ? "Modalidade_PIX" : "Modalidade_Cartao");
    }

    // ACCORDION
    function toggleAccordion(btn) {
        const item = btn.parentElement;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
        lucide.createIcons();
    }

    // REVEAL ON SCROLL
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
            }
        });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // SCROLL NAVBAR & CTA
    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        const ctaFloat = document.getElementById('cta-float');
        
        if (window.scrollY > 50) {
            if(navbar) navbar.classList.add('shadow-md');
        } else {
            if(navbar) navbar.classList.remove('shadow-md');
        }

        if (window.scrollY > 400) {
            if(ctaFloat) {
                ctaFloat.classList.remove('hidden', 'opacity-0', 'translate-y-10', 'pointer-events-none');
                ctaFloat.classList.add('opacity-100', 'translate-y-0');
            }
        } else {
            if(ctaFloat) {
                ctaFloat.classList.remove('opacity-100', 'translate-y-0');
                ctaFloat.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }
        }
    });

    // VIDEO UNMUTE CONTROLLERS
    document.addEventListener("DOMContentLoaded", function() {
        renderPricing();

        const videoFacial = document.getElementById('video-facial');
        const overlayFacial = document.getElementById('overlay-facial');
        const videoPpa = document.getElementById('video-ppa');
        const overlayPpa = document.getElementById('overlay-ppa');

        // Pausar o outro vídeo quando um começar a tocar
        if (videoFacial && videoPpa) {
            videoFacial.addEventListener('play', function() {
                if (!videoPpa.paused) {
                    videoPpa.pause();
                }
            });

            videoPpa.addEventListener('play', function() {
                if (!videoFacial.paused) {
                    videoFacial.pause();
                }
            });
        }

        // Vídeo 1: Facial (com áudio ativável)
        if (videoFacial && overlayFacial) {
            overlayFacial.addEventListener('click', function(e) {
                e.stopPropagation();
                if (videoPpa) videoPpa.pause();
                videoFacial.muted = false;
                videoFacial.loop = false;
                videoFacial.currentTime = 0;
                videoFacial.play();
                overlayFacial.style.opacity = '0';
                setTimeout(() => { overlayFacial.style.display = 'none'; }, 400);

                if (window.clarity) {
                    window.clarity("event", "Video_Assistido_video-facial");
                }
            });

            videoFacial.addEventListener('click', function() {
                if (overlayFacial.style.display === 'none') {
                    if (videoFacial.paused) {
                        if (videoPpa) videoPpa.pause();
                        videoFacial.play();
                    } else {
                        videoFacial.pause();
                    }
                }
            });
        }

        // Vídeo 2: Porta Deslizante PPA (estritamente SEM SOM)
        if (videoPpa && overlayPpa) {
            videoPpa.muted = true; // Garante sem som sempre

            overlayPpa.addEventListener('click', function(e) {
                e.stopPropagation();
                if (videoFacial) videoFacial.pause();
                videoPpa.muted = true; // Permanece estritamente mudo
                videoPpa.loop = true;
                videoPpa.currentTime = 0;
                videoPpa.play();
                overlayPpa.style.opacity = '0';
                setTimeout(() => { overlayPpa.style.display = 'none'; }, 400);

                if (window.clarity) {
                    window.clarity("event", "Video_Assistido_video-ppa");
                }
            });

            videoPpa.addEventListener('click', function() {
                if (overlayPpa.style.display === 'none') {
                    if (videoPpa.paused) {
                        if (videoFacial) videoFacial.pause();
                        videoPpa.play();
                    } else {
                        videoPpa.pause();
                    }
                }
            });
        }

        // Vídeo da Apresentadora do Topo
        function setupHeroVideo(videoId, overlayId) {
            const video = document.getElementById(videoId);
            const overlay = document.getElementById(overlayId);
            if (video && overlay) {
                overlay.addEventListener("click", function(e) {
                    e.stopPropagation(); 
                    if (videoFacial) videoFacial.pause();
                    if (videoPpa) videoPpa.pause();
                    video.muted = false;
                    video.loop = false; 
                    video.currentTime = 0;
                    video.play();
                    overlay.style.opacity = "0";
                    setTimeout(() => { overlay.style.display = "none"; }, 500); 

                    if (window.clarity) {
                        window.clarity("event", "Video_Assistido_" + videoId);
                    }
                });
                video.addEventListener("click", function() {
                    if (overlay.style.display === "none") {
                        if (video.paused) { 
                            if (videoFacial) videoFacial.pause();
                            if (videoPpa) videoPpa.pause();
                            video.play(); 
                        } else { 
                            video.pause(); 
                        }
                    }
                });
            }
        }

        setupHeroVideo("vision-video", "unmute-overlay");
    });
</script>
