    // ACCORDION TOGGLE
    function toggleAccordion(button) {
        const item = button.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }

    // CONTROLE DE ACESSO (LOCK SCREEN)
    function checkPassword() {
        const inputEl = document.getElementById('password-input');
        if (!inputEl) return;

        const input = inputEl.value.trim().toUpperCase();
        const errorMsg = document.getElementById('error-msg');
        const btnUnlock = document.getElementById('btn-unlock');
        const unlockIcon = document.getElementById('unlock-icon');
        const unlockText = document.getElementById('unlock-text');
        const unlockArrow = document.getElementById('unlock-arrow');

        const validPasswords = ['WILLAS2026', 'MERCADO2026', 'WILLAS', 'MERCADO', 'VISION'];

        if (validPasswords.includes(input)) {
            if (btnUnlock) btnUnlock.disabled = true;
            if (unlockText) unlockText.textContent = "Validando Acesso...";
            if (unlockIcon) unlockIcon.className = "w-5 h-5 animate-spin text-black";
            if (unlockArrow) unlockArrow.style.display = 'none';

            setTimeout(() => {
                const lockScreen = document.getElementById('lock-screen');
                if (lockScreen) lockScreen.style.opacity = '0';

                const video = document.getElementById("vision-video");
                if (video && video.paused) {
                    video.muted = true;
                    video.play().catch(() => {});
                }

                if (window.clarity) {
                    try {
                        window.clarity("consent");
                        window.clarity("identify", "willas-minimercado", undefined, undefined, "Willas (Mini Mercado)");
                        window.clarity("set", "Proposta", "Projeto_Facial_MiniMercado");
                        window.clarity("event", "Proposta_Desbloqueada_Willas");
                    } catch(e) {}
                }

                // Log silencioso de abertura
                fetch('https://api.staticforms.dev/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        accessKey: "sf_077ej49gjha153gk3m6ceecf",
                        subject: "🚨 ALERTA: Proposta Acessada (Willas - Mini Mercado)",
                        name: "Sistema Vision",
                        email: "diretoria@visionsp.com.br",
                        message: "O cliente Willas acessou a proposta do controle facial do mini mercado!\n\n🔑 Senha Utilizada: " + input + "\n🕒 Horário: " + new Date().toLocaleString('pt-BR')
                    })
                }).catch(() => {});

                setTimeout(() => {
                    if (lockScreen) lockScreen.style.display = 'none';
                    const htmlRoot = document.getElementById('html-root');
                    if (htmlRoot) {
                        htmlRoot.classList.remove('overflow-hidden', 'h-screen');
                        htmlRoot.classList.add('overflow-x-hidden');
                    }
                    document.body.classList.remove('overflow-hidden', 'h-screen');
                    document.body.classList.add('overflow-x-hidden');
                }, 700);

            }, 600);

        } else {
            if (errorMsg) errorMsg.classList.remove('hidden');
            inputEl.style.borderColor = 'rgba(239,68,68,0.5)';
            setTimeout(() => {
                if (errorMsg) errorMsg.classList.add('hidden');
                inputEl.style.borderColor = '';
            }, 3000);
        }
    }

    // EVENT LISTENERS & INICIALIZAÇÃO
    document.addEventListener("DOMContentLoaded", function() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }

        const pwdInput = document.getElementById('password-input');
        if (pwdInput) {
            pwdInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });
        }

        try {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('active');
                });
            }, { threshold: 0.08 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        } catch(e) {
            document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
        }

        const videoHero = document.getElementById("vision-video");
        const overlayHero = document.getElementById("unmute-overlay");

        if (videoHero && overlayHero) {
            overlayHero.addEventListener("click", function(e) {
                e.stopPropagation();
                videoHero.muted = false;
                videoHero.loop = true;
                videoHero.currentTime = 0;
                videoHero.play().catch(() => {});
                overlayHero.style.opacity = "0";
                setTimeout(() => { overlayHero.style.display = "none"; }, 400);

                if (window.clarity) {
                    try { window.clarity("event", "Video_Assistido_Willas"); } catch(err) {}
                }
            });

            videoHero.addEventListener("click", function() {
                if (overlayHero.style.display === "none") {
                    if (videoHero.paused) { videoHero.play(); } else { videoHero.pause(); }
                }
            });
        }

        renderPriceDisplay();

        const reviewsTrack = document.getElementById('reviews-track');
        const reviewsContainer = document.getElementById('reviews-container');
        if (reviewsTrack && reviewsContainer) {
            reviewsContainer.addEventListener('touchstart', function() {
                reviewsTrack.classList.add('paused');
            }, { passive: true });

            reviewsContainer.addEventListener('touchend', function() {
                reviewsTrack.classList.remove('paused');
            }, { passive: true });

            reviewsContainer.addEventListener('touchcancel', function() {
                reviewsTrack.classList.remove('paused');
            }, { passive: true });
        }
    });

    // Navbar Scroll Shadow
    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        if (navbar) {
            if (window.scrollY > 40) {
                navbar.classList.add('shadow-md');
            } else {
                navbar.classList.remove('shadow-md');
            }
        }
    });
</script>
